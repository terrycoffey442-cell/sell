local function getPlayerDiamonds()
    local success, count = pcall(function()
        local Lib = ReplicatedStorage:FindFirstChild("Library")
        if Lib then
            local Client = Lib:WaitForChild("Client")
            local okCmds, CurrencyCmds = pcall(require, Client:WaitForChild("CurrencyCmds"))
            if okCmds and CurrencyCmds and CurrencyCmds.Get then
                local amt = CurrencyCmds.Get("Diamonds")
                if type(amt) == "number" then return amt end
            end

            local Save = require(Client:WaitForChild("Save"))
            local data = Save.Get()
            if data then
                if data.Currency and type(data.Currency.Diamonds) == "number" then
                    return data.Currency.Diamonds
                elseif data.Diamonds then
                    return data.Diamonds
                end
            end
        end
        return 0
    end)
    if success and count then return count end
    
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    local diamonds = leaderstats and (leaderstats:FindFirstChild("Diamonds") or leaderstats:FindFirstChild("💎 Diamonds") or leaderstats:FindFirstChild("Gems"))
    if diamonds then
        local val = tostring(diamonds.Value):gsub(",", ""):match("%d+")
        return tonumber(val) or 0
    end
    return 0
end

