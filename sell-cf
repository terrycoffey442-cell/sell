-- Hàm tra cứu cấu hình của 1 item
local function getItemConfig(name, itemObj)
    local itemsTable = (getgenv().PlazaSellConfig and getgenv().PlazaSellConfig.Items) or Config.Items
    if not itemsTable then return nil end
    if itemsTable[name] then return itemsTable[name] end
    
    local noShiny = name:gsub("^Shiny%s+", "")
    if itemsTable[noShiny] then return itemsTable[noShiny] end
    
    if itemObj then
        local baseName = nil
        pcall(function() baseName = itemObj:Directory().name end)
        if baseName then
            if itemsTable[baseName] then return itemsTable[baseName] end
            local isGold = false
            local isRb = false
            pcall(function() isGold = itemObj:IsGolden() end)
            pcall(function() isRb = itemObj:IsRainbow() end)
            if isGold and itemsTable["Golden " .. baseName] then
                return itemsTable["Golden " .. baseName]
            elseif isRb and itemsTable["Rainbow " .. baseName] then
                return itemsTable["Rainbow " .. baseName]
            end
        end
    end
    return nil
end

