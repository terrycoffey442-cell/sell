-- 7. VÒNG LẶP AUTO SELL TREO BÁN TỰ ĐỘNG (BACKGROUND AUTO-SELL ENGINE)
-- ==============================================================================
local mySession = math.random(100000, 999999)
getgenv().AutoSellSession = mySession
getgenv().PlazaSellItemCooldowns = getgenv().PlazaSellItemCooldowns or {}

local function runAutoSellProcess()
    while true do
        task.wait(10)
        
        if getgenv().AutoSellSession ~= mySession then
            break
        end
        
        local cfg = getgenv().PlazaSellConfig
        if cfg and cfg.Enabled then
            local ok, err = pcall(function()
                -- 1. Kiểm tra trạng thái Trading Plaza
                local isOnPlaza = false
                local LibraryInstance = ReplicatedStorage:FindFirstChild("Library")
                if not LibraryInstance then return end
                
                local Client = LibraryInstance:FindFirstChild("Client")
                local TradingPlazaCmds
                local cmdModule = Client and Client:FindFirstChild("TradingPlazaCmds")
                if cmdModule then
                    pcall(function() TradingPlazaCmds = require(cmdModule) end)
                end
                
                if TradingPlazaCmds and TradingPlazaCmds.IsOnTradingPlaza then
                    isOnPlaza = TradingPlazaCmds.IsOnTradingPlaza()
                else
                    isOnPlaza = game.PlaceId == 15502339080 or game.PlaceId == 15588442388 or workspace:FindFirstChild("TradingPlaza") ~= nil
                end
                if not isOnPlaza then return end
                
                -- 2. Kiểm tra Player Global Cooldown
                local globalCooldown = getgenv().PlazaSellGlobalCooldown
                local globalCooldownDur = getgenv().PlazaSellGlobalCooldownDur or 120
                if globalCooldown then
                    local elapsed = os.time() - globalCooldown
                    if elapsed < globalCooldownDur then
                        if elapsed % 30 == 0 or elapsed == 0 then
                            print(string.format("[AUTO SELL] Player cooldown active. Waiting... (%ds / %ds)", elapsed, globalCooldownDur))
                        end
                        return
                    else
                        getgenv().PlazaSellGlobalCooldown = nil
                        getgenv().PlazaSellGlobalCooldownDur = nil
                        getgenv().PlazaSellItemCooldowns = {}
                        getgenv().PlazaSellListedCache = nil
                        print("[AUTO SELL] Player cooldown expired. Resuming operation...")
                    end
                end
                
                -- 3. Hàm chiếm booth trống tốt nhất
                local function claimBestBooth()
                    local TradingPlaza = workspace:FindFirstChild("TradingPlaza")
                    local BoothSpawns = TradingPlaza and TradingPlaza:FindFirstChild("BoothSpawns")
                    if not BoothSpawns then 
                        print("[DEBUG] Folder BoothSpawns not found in Workspace!")
                        return false, nil 
                    end
                    
                    local candidates = {}
                    for _, child in ipairs(BoothSpawns:GetChildren()) do
                        local idAttr = child:GetAttribute("ID")
                        if idAttr then
                            table.insert(candidates, {
                                model = child,
                                id = idAttr,
                                numId = tonumber(idAttr) or 999
                            })
                        end
                    end
                    
                    table.sort(candidates, function(a, b)
                        return a.numId < b.numId
                    end)
                    
                    for _, candidate in ipairs(candidates) do
                        if candidate.model.Parent == BoothSpawns then
                            pcall(function()
                                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                    LocalPlayer.Character:PivotTo(candidate.model:GetPivot() * CFrame.new(0, 4.5, 4.5))
                                end
                            end)
                            task.wait(0.2)
                            
                            local success = Network.Invoke("Booths_ClaimBooth", candidate.id)
                            if success then
                                print(string.format("[BOOTH] Claimed Booth #%s", tostring(candidate.id)))
                                return true, candidate.id
                            end
                            task.wait(0.1)
                        end
                    end
                    return false, nil
                end

                -- 4. Hàm lấy danh sách UID vật phẩm đang treo bán & số slot đang treo theo tên item / category
                local function getListedUIDs(forceRefresh)
                    local CACHE_TTL = 10
                    local cache = getgenv().PlazaSellListedCache
                    
                    if not forceRefresh and cache and cache.ts and (os.time() - cache.ts) < CACHE_TTL then
                        return cache.listed, cache.count, cache.slotsByName, cache.slotsByCat
                    end
                    
                    local listed = {}
                    local slotsByName = {}
                    local slotsByCat = {}
                    local states = nil
                    
                    pcall(function()
                        local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
                        local BoothCmds = (Client and Client:FindFirstChild("BoothCmds")) 
                            or (playerScripts and (playerScripts:FindFirstChild("Booths Frontend", true) or playerScripts:FindFirstChild("BoothCmds", true)))
                            
                        if BoothCmds and getsenv then
                            local env = getsenv(BoothCmds)
                            if env then
                                local getStateFunc = env.getState or env.GetState
                                if type(getStateFunc) == "function" then
                                    local myState = getStateFunc(LocalPlayer)
                                    if not myState and getupvalues then
                                        local upvs = getupvalues(getStateFunc)
                                        if upvs and upvs[1] and type(upvs[1]) == "table" then
                                            myState = upvs[1][LocalPlayer] or upvs[1][LocalPlayer.UserId]
                                        end
                                    end
                                    if myState and myState.Listings then
                                        states = { [LocalPlayer] = myState }
                                    end
                                end
                            end
                        end
                    end)
                    
                    if states and states[LocalPlayer] then
                        local myState = states[LocalPlayer]
                        local count = 0
                        for _, listing in pairs(myState.Listings) do
                            local itemUID = nil
                            local listedItemName = nil
                            local listedCat = nil
                            
                            if listing.Item then
                                pcall(function() itemUID = listing.Item:GetUID() end)
                                pcall(function() listedItemName = listing.Item:GetName() end)
                                pcall(function()
                                    if (listing.Item.IsHuge and listing.Item:IsHuge()) or (listedItemName and listedItemName:find("Huge")) then
                                        listedCat = "Huge"
                                    elseif (listing.Item.IsTitanic and listing.Item:IsTitanic()) or (listedItemName and listedItemName:find("Titanic")) then
                                        listedCat = "Titanic"
                                    elseif (listing.Item.IsGargantuan and listing.Item:IsGargantuan()) or (listedItemName and listedItemName:find("Gargantuan")) then
                                        listedCat = "Gargantuan"
                                    elseif listing.Item.GetCategory then
                                        listedCat = listing.Item:GetCategory()
                                    end
                                end)
                                if not itemUID and listing.Item._uid then itemUID = listing.Item._uid end
                                if not itemUID and listing.Item.uid then itemUID = listing.Item.uid end
                            end
                            if not itemUID and listing.ItemData and listing.ItemData.uid then
                                itemUID = listing.ItemData.uid
                            end
                            if not listedItemName and listing.ItemData and listing.ItemData.id then
                                listedItemName = listing.ItemData.id
                            end
                            if not listedCat and listing.ItemData then
                                listedCat = listing.ItemData._cat or listing.ItemData.cat
                            end
                            if listedItemName then
                                if listedItemName:find("Huge") then listedCat = "Huge"
                                elseif listedItemName:find("Titanic") then listedCat = "Titanic"
                                elseif listedItemName:find("Gargantuan") then listedCat = "Gargantuan"
                                end
                            end
                            
                            if itemUID then
                                local amt = 1
                                if listing.Item then
                                    pcall(function() amt = listing.Item:GetAmount() or 1 end)
                                elseif listing.ItemData then
                                    amt = listing.ItemData._am or listing.ItemData.am or 1
                                end
                                listed[itemUID] = (listed[itemUID] or 0) + amt
                                count = count + 1
                                if listedItemName then
                                    slotsByName[listedItemName] = (slotsByName[listedItemName] or 0) + 1
                                end
                                if listedCat then
                                    slotsByCat[listedCat] = (slotsByCat[listedCat] or 0) + 1
                                end
                            end
                        end
                        getgenv().PlazaSellListedCache = { listed = listed, count = count, slotsByName = slotsByName, slotsByCat = slotsByCat, ts = os.time() }
                        return listed, count, slotsByName, slotsByCat
                    end
                    
                    -- Fallback qua Network.Invoke
                    local success, serverStates = pcall(function()
                        return Network.Invoke("Booths_GetInitialState")
                    end)
                    if success and type(serverStates) == "table" then
                        for k, state in pairs(serverStates) do
                            if type(state) == "table" then
                                local isMine = false
                                if tostring(k) == tostring(LocalPlayer.UserId) then isMine = true end
                                
                                local pObj = state.Player or state.Owner or state.player or state.owner
                                if typeof(pObj) == "Instance" and pObj:IsA("Player") and pObj.UserId == LocalPlayer.UserId then
                                    isMine = true
                                end
                                
                                local pId = state.PlayerID or state.PlayerId or state.UserId or state.OwnerId or state.PlayerUserId
                                if pId and tostring(pId) == tostring(LocalPlayer.UserId) then
                                    isMine = true
                                end
                                
                                if isMine and state.Listings then
                                    local count = 0
                                    for _, listing in pairs(state.Listings) do
                                        if listing.ItemData and listing.ItemData.uid then
                                            local amt = listing.ItemData._am or listing.ItemData.am or 1
                                            local iName = listing.ItemData.id
                                            local iCat = listing.ItemData._cat or listing.ItemData.cat
                                            if iName then
                                                if iName:find("Huge") then iCat = "Huge"
                                                elseif iName:find("Titanic") then iCat = "Titanic"
                                                elseif iName:find("Gargantuan") then iCat = "Gargantuan"
                                                end
                                            end
                                            listed[listing.ItemData.uid] = (listed[listing.ItemData.uid] or 0) + amt
                                            count = count + 1
                                            if iName then
                                                slotsByName[iName] = (slotsByName[iName] or 0) + 1
                                            end
                                            if iCat then
                                                slotsByCat[iCat] = (slotsByCat[iCat] or 0) + 1
                                            end
                                        end
                                    end
                                    getgenv().PlazaSellListedCache = { listed = listed, count = count, slotsByName = slotsByName, slotsByCat = slotsByCat, ts = os.time() }
                                    getgenv().PlazaSellLastStateCall = os.time()
                                    return listed, count, slotsByName, slotsByCat
                                end
                            end
                        end
                    end
                    return listed, 0, slotsByName, slotsByCat
                end

                -- 5. Đảm bảo nhân vật đã chiếm được quầy
                local myBooth = nil
                pcall(function()
                    local activeModel = Signal.Invoke("Booths_GetActiveModel")
                    if activeModel then
                        myBooth = activeModel
                    end
                end)
                
                if not myBooth then
                    pcall(function()
                        local things = workspace:FindFirstChild("__THINGS")
                        local boothsFolder = things and things:FindFirstChild("Booths")
                        if boothsFolder then
                            for _, boothModel in ipairs(boothsFolder:GetChildren()) do
                                local ownerId = boothModel:GetAttribute("Owner")
                                if ownerId and tostring(ownerId) == tostring(LocalPlayer.UserId) then
                                    myBooth = boothModel
                                    break
                                end
                            end
                        end
                    end)
                end
                
                if not myBooth then
                    print("[AUTO SELL] Finding and claiming best empty booth...")
                    local claimed, boothId = claimBestBooth()
                    if claimed then
                        print("[AUTO SELL] Successfully claimed Booth ID:", boothId)
                        getgenv().PlazaSellFreshClaimTime = os.time()
                        getgenv().PlazaSellGlobalCooldown = nil
                        getgenv().PlazaSellGlobalCooldownDur = nil
                        getgenv().PlazaSellItemCooldowns = {}
                        getgenv().PlazaSellListedCache = { listed = {}, count = 0, slotsByName = {}, slotsByCat = {}, ts = os.time() }
                        getgenv().PlazaSellSlotCache = 0
                        task.wait(3.0)
                    else
                        print("[AUTO SELL] Could not claim a booth (Cooldown/Rate Limit). Retrying in 30s...")
                        getgenv().PlazaSellGlobalCooldown = os.time()
                        getgenv().PlazaSellGlobalCooldownDur = 30
                        return
                    end
                end
                
                -- 6. Quét rương đồ và tìm các vật phẩm đủ điều kiện treo bán
                local Save = require(LibraryInstance:WaitForChild("Client"):WaitForChild("Save"))
                local Types = require(LibraryInstance:WaitForChild("Items"):WaitForChild("Types"))
                local data = Save.Get()
                if not data or not data.Inventory then return end
                
                local listedUIDs, listedCount, listedSlotsByName, listedSlotsByCat = getListedUIDs(false)
                getgenv().PlazaSellSlotCache = listedCount
                
                local MAX_BOOTH_SLOTS = 25
                if listedCount >= MAX_BOOTH_SLOTS then
                    local lastFullLog = getgenv().PlazaSellLastFullLog or 0
                    if os.time() - lastFullLog >= 60 then
                        print(string.format("[AUTO SELL] Booth full (%d/%d). Monitoring for sold slots...", listedCount, MAX_BOOTH_SLOTS))
                        getgenv().PlazaSellLastFullLog = os.time()
                    end
                    return
                end
                
                local qualifiedQueue = {}
                local queuedSlotsByName = {}
                local queuedSlotsByCat = {}
                local scanStats = { total = 0, locked = 0, noPrice = 0, cooldown = 0, alreadyListed = 0, limitReached = 0, slotsMaxed = 0 }
                
                for catName, catData in pairs(data.Inventory) do
                    for uid, itemData in pairs(catData) do
                        if not getgenv().PlazaSellConfig.Enabled then return end
                        
                        local success, itemObj = pcall(function() return Types.From(catName, itemData) end)
                        if success and itemObj then
                            local isLocked = false
                            pcall(function() isLocked = itemObj:IsLocked() end)
                            
                            if isLocked then
                                scanStats.locked = scanStats.locked + 1
                            else
                                local itemName = itemObj:GetName()
                                local priceSource = "Custom (Items)"
                                scanStats.total = scanStats.total + 1
                                
                                local itemCfg = getItemConfig(itemName, itemObj)
                                local sellPrice = nil
                                local priceSource = "Custom (Fixed)"
                                
                                if itemCfg then
                                    if itemCfg.Cosmic ~= nil then
                                        local cosmicModule = LibraryInstance:FindFirstChild("Client") and LibraryInstance.Client:FindFirstChild("CosmicCmds")
                                        if cosmicModule then
                                            local CosmicCmds = require(cosmicModule)
                                            local cosmicSuccess, cosmicVal = pcall(function() return CosmicCmds.Get(itemObj) end)
                                            if cosmicSuccess and type(cosmicVal) == "number" and cosmicVal > 0 then
                                                local pct = itemCfg.Cosmic
                                                sellPrice = math.max(1, math.floor(cosmicVal * (1 + pct / 100)))
                                                priceSource = string.format("Item Cosmic (%+d%%)", pct)
                                            end
                                        end
                                    elseif itemCfg.RAP ~= nil then
                                        local RAPCmds = require(LibraryInstance:WaitForChild("Client"):WaitForChild("RAPCmds"))
                                        local rapSuccess, rapResult = pcall(function() return RAPCmds.Get(itemObj) end)
                                        if rapSuccess and type(rapResult) == "number" and rapResult > 0 then
                                            local pct = itemCfg.RAP
                                            sellPrice = math.max(1, math.floor(rapResult * (1 + pct / 100)))
                                            priceSource = string.format("Item RAP (%+d%%)", pct)
                                        end
                                    elseif itemCfg.Price and itemCfg.Price > 0 then
                                        sellPrice = itemCfg.Price
                                        priceSource = "Custom (Fixed)"
                                    end
                                end
                                
                                local targetQty = itemCfg and itemCfg.Amount or "All"
                                local limitVal = itemCfg and itemCfg.Limit or "All"
                                local configuredSlots = itemCfg and itemCfg.Slots or "All"
                                
                                local isStackableItem = not (catName == "Pet" or catName == "Hoverboard" or catName == "Booth")
                                
                                -- 4. Tra cứu theo CategoryRules nếu item không nằm trong bảng Items (hoặc itemCfg không có thiết lập giá riêng)
                                local itemCategory = catName
                                if catName == "Pet" then
                                    if itemObj.IsHuge and itemObj:IsHuge() then itemCategory = "Huge"
                                    elseif itemObj.IsTitanic and itemObj:IsTitanic() then itemCategory = "Titanic"
                                    elseif (itemObj.IsGargantuan and itemObj:IsGargantuan()) or (itemObj.Gargantuan and itemObj:Gargantuan()) or (itemName and tostring(itemName):find("Gargantuan")) then itemCategory = "Gargantuan"
                                    end
                                end
                                
                                local hasItemExplicitPrice = itemCfg and (itemCfg.Cosmic ~= nil or itemCfg.RAP ~= nil or (itemCfg.Price and itemCfg.Price > 0))
                                if (not sellPrice or sellPrice <= 0) and not hasItemExplicitPrice then
                                    local rule = cfg.CategoryRules and cfg.CategoryRules[itemCategory]
                                    if rule and rule.Mode ~= "Disabled" then
                                        if configuredSlots == "All" and rule.Slots ~= nil and rule.Slots ~= "All" then
                                            configuredSlots = rule.Slots
                                        end
                                        
                                        if rule.Mode == "Fixed" then
                                            sellPrice = tonumber(rule.Price) or 0
                                            priceSource = "Category (Fixed)"
                                        elseif rule.Mode == "Cosmic" then
                                            local cosmicModule = LibraryInstance:FindFirstChild("Client") and LibraryInstance.Client:FindFirstChild("CosmicCmds")
                                            if cosmicModule then
                                                local CosmicCmds = require(cosmicModule)
                                                local cosmicSuccess, cosmicVal = pcall(function() return CosmicCmds.Get(itemObj) end)
                                                if cosmicSuccess and type(cosmicVal) == "number" and cosmicVal > 0 then
                                                    local pct = tonumber(rule.Percent) or 0
                                                    sellPrice = math.max(1, math.floor(cosmicVal * (1 + pct / 100)))
                                                    priceSource = string.format("Cosmic (%+d%%)", pct)
                                                end
                                            end
                                        elseif rule.Mode == "RAP" then
                                            local RAPCmds = require(LibraryInstance:WaitForChild("Client"):WaitForChild("RAPCmds"))
                                            local rapSuccess, rapResult = pcall(function() return RAPCmds.Get(itemObj) end)
                                            if rapSuccess and type(rapResult) == "number" and rapResult > 0 then
                                                local pct = tonumber(rule.Percent) or 0
                                                sellPrice = math.max(1, math.floor(rapResult * (1 + pct / 100)))
                                                priceSource = string.format("RAP (%+d%%)", pct)
                                            end
                                        end
                                    end
                                end
                                
                                if sellPrice and sellPrice > 0 then
                                    local totalAmtInInv = itemObj:GetAmount() or 1
                                    local alreadyListedAmt = listedUIDs[uid] or 0
                                    
                                    -- Đếm số slot đang chiếm dụng (gồm đã list trên quầy + đã xếp vào queue trong tick này)
                                    local currentOccupiedSlots = ((listedSlotsByName and (listedSlotsByName[itemName] or listedSlotsByName[itemData.id])) or 0) + (queuedSlotsByName[itemName] or 0)
                                    if (not itemCfg) and itemCategory and listedSlotsByCat then
                                        local catOccupied = (listedSlotsByCat[itemCategory] or 0) + (queuedSlotsByCat[itemCategory] or 0)
                                        currentOccupiedSlots = math.max(currentOccupiedSlots, catOccupied)
                                    end
                                    
                                    -- Quota còn lại được phép list lên quầy
                                    local remQuota = (targetQty == "All") and (totalAmtInInv - alreadyListedAmt) or math.max(0, (tonumber(targetQty) or 0) - alreadyListedAmt)
                                    
                                    -- Tính toán số slot tối đa được phép treo cho item này trong tick này
                                    local maxSlotsForItem
                                    if not isStackableItem then
                                        maxSlotsForItem = 1
                                    elseif configuredSlots ~= "All" then
                                        local allowedRemSlots = math.max(0, (tonumber(configuredSlots) or 1) - currentOccupiedSlots)
                                        maxSlotsForItem = math.min(allowedRemSlots, MAX_BOOTH_SLOTS - listedCount)
                                    elseif targetQty == "All" then
                                        maxSlotsForItem = MAX_BOOTH_SLOTS - listedCount
                                    else
                                        maxSlotsForItem = math.max(1, math.ceil(remQuota / 50000))
                                    end
                                    
                                    local itemCooldowns = getgenv().PlazaSellItemCooldowns
                                    local isCoolingDown = itemCooldowns[uid] and (os.time() - itemCooldowns[uid]) < 60
                                    local isLimitReached = limitVal ~= "All" and (tonumber(limitVal) or 0) <= 0
                                    local isAmountReached = targetQty ~= "All" and (tonumber(targetQty) or 0) <= 0
                                    local isQuotaSatisfied = targetQty ~= "All" and (alreadyListedAmt >= (tonumber(targetQty) or 0))
                                    local isSlotsMaxed = configuredSlots ~= "All" and currentOccupiedSlots >= (tonumber(configuredSlots) or 1)
                                    local isAlreadyListed = (not isStackableItem and alreadyListedAmt > 0) or (isStackableItem and (alreadyListedAmt >= totalAmtInInv or isQuotaSatisfied))
                                    
                                    if not isCoolingDown and not isLimitReached and not isAmountReached and not isSlotsMaxed and not isAlreadyListed and remQuota > 0 and maxSlotsForItem > 0 then
                                        local remInv = math.min(totalAmtInInv - alreadyListedAmt, remQuota)
                                        table.insert(qualifiedQueue, {
                                            cat = catName,
                                            itemCat = itemCategory,
                                            name = itemName,
                                            price = sellPrice,
                                            priceSource = priceSource,
                                            amt = remInv,
                                            uid = uid,
                                            limitVal = limitVal,
                                            targetQty = remQuota,
                                            configuredSlots = configuredSlots,
                                            maxSlots = maxSlotsForItem,
                                            isStackable = isStackableItem
                                        })
                                        queuedSlotsByName[itemName] = (queuedSlotsByName[itemName] or 0) + maxSlotsForItem
                                        if itemCategory then
                                            queuedSlotsByCat[itemCategory] = (queuedSlotsByCat[itemCategory] or 0) + maxSlotsForItem
                                        end
                                    elseif isCoolingDown then
                                        scanStats.cooldown = scanStats.cooldown + 1
                                    elseif isLimitReached or isAmountReached or isQuotaSatisfied then
                                        scanStats.limitReached = scanStats.limitReached + 1
                                    elseif isSlotsMaxed then
                                        scanStats.slotsMaxed = scanStats.slotsMaxed + 1
                                    elseif isAlreadyListed then
                                        scanStats.alreadyListed = scanStats.alreadyListed + 1
                                    end
                                else
                                    scanStats.noPrice = scanStats.noPrice + 1
                                end
                            end
                        end
                    end
                end
                
                -- Đảm bảo khoảng cách an toàn 4s giữa GetInitialState và CreateListing
                local lastStateCall = getgenv().PlazaSellLastStateCall
                if lastStateCall then
                    local gap = os.time() - lastStateCall
                    if gap < 4 then
                        task.wait(4 - gap)
                    end
                    getgenv().PlazaSellLastStateCall = nil
                end
                
                -- Tiến hành đăng bán lần lượt các item trong Queue
                local globalCooldownTriggered = false
                local listedCountBeforeTick = listedCount
                for _, item in ipairs(qualifiedQueue) do
                    if not getgenv().PlazaSellConfig.Enabled then break end
                    if listedCount >= MAX_BOOTH_SLOTS then break end
                    
                    local remainingInventory = item.amt
                    local uid = item.uid
                    local itemName = item.name
                    local sellPrice = item.price
                    local targetQty = item.targetQty
                    
                    local slotsUsedForItem = 0
                    while remainingInventory > 0 and getgenv().PlazaSellConfig.Enabled do
                        if listedCount >= MAX_BOOTH_SLOTS then break end
                        if targetQty ~= "All" and (tonumber(targetQty) or 0) <= 0 then break end
                        if item.isStackable and slotsUsedForItem >= (item.maxSlots or 1) then break end
                        
                        local sellAmt = remainingInventory
                        if targetQty ~= "All" then
                            sellAmt = math.min(remainingInventory, tonumber(targetQty) or 1)
                        end
                        sellAmt = math.min(sellAmt, 50000)
                        if sellAmt <= 0 then break end
                        
                        local listSuccess, errMsg = Network.Invoke("Booths_CreateListing", uid, sellPrice, sellAmt)
                        if listSuccess then
                            listedCount = listedCount + 1
                            slotsUsedForItem = slotsUsedForItem + 1
                            remainingInventory = remainingInventory - sellAmt
                            if targetQty ~= "All" then
                                local remQ = (tonumber(targetQty) or sellAmt) - sellAmt
                                targetQty = (remQ <= 0) and 0 or remQ
                            end
                            getgenv().PlazaSellSlotCache = listedCount
                            listedUIDs[uid] = (listedUIDs[uid] or 0) + sellAmt
                            if listedSlotsByName then
                                listedSlotsByName[itemName] = (listedSlotsByName[itemName] or 0) + 1
                            end
                            if listedSlotsByCat and item.itemCat then
                                listedSlotsByCat[item.itemCat] = (listedSlotsByCat[item.itemCat] or 0) + 1
                            end
                            print(string.format("[AUTO SELL] Listed %s x%s @ %s Gems (%s) [%d/%d]",
                                itemName, formatNumber(sellAmt), formatNumber(sellPrice), item.priceSource, listedCount, MAX_BOOTH_SLOTS))
                            task.wait(2.5)
                        else
                            local errStr = tostring(errMsg):lower()
                            print(string.format("[AUTO SELL ERROR] Failed to list %s: %s", itemName, tostring(errMsg)))
                            if errStr:find("slot") or errStr:find("full") or errStr:find("limit") or errStr:find("no empty") then
                                listedCount = MAX_BOOTH_SLOTS
                                break
                            elseif errStr:find("fast") or errStr:find("too") then
                                print(string.format("[AUTO SELL] Rate limit hit. Pausing 8s..."))
                                task.wait(8.0)
                                break
                            elseif errStr:find("cooldown") or errStr:find("wait") then
                                if listedCount == listedCountBeforeTick then
                                    local prevDur = getgenv().PlazaSellGlobalCooldownDur or 60
                                    local nextDur = math.min(prevDur * 2, 300)
                                    getgenv().PlazaSellGlobalCooldown = os.time()
                                    getgenv().PlazaSellGlobalCooldownDur = nextDur
                                    print(string.format("[AUTO SELL] Cooldown active! Waiting %ds...", nextDur))
                                    globalCooldownTriggered = true
                                    break
                                else
                                    getgenv().PlazaSellItemCooldowns[uid] = os.time()
                                    task.wait(3.0)
                                end
                                break
                            end
                            getgenv().PlazaSellItemCooldowns[uid] = os.time()
                            break
                        end
                    end
                    if globalCooldownTriggered then break end
                end
            end)
            if not ok then
                print("[AUTO SELL PROCESS ERROR]", tostring(err))
            end
        end
    end
end

task.spawn(runAutoSellProcess)
