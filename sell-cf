-- 4. HỆ THỐNG DISCORD WEBHOOK (BATCH NOTIFICATION)
-- ==============================================================================
local pendingWebhookSales = {}
local isWebhookBatchScheduled = false

local function processBatchWebhook()
    local salesToProcess = pendingWebhookSales
    pendingWebhookSales = {}
    isWebhookBatchScheduled = false
    
    if #salesToProcess == 0 then return end
    
    local cfg = getgenv().PlazaSellConfig
    if not cfg then return end
    local webhookURL = cfg.WebhookURL
    if not webhookURL or webhookURL == "" or not webhookURL:find("https://discord.com/api/webhooks") then return end
    
    pcall(function()
        local itemSummary = {}
        local grandTotalPrice = 0
        local lastIconUrl = nil
        
        for _, sale in ipairs(salesToProcess) do
            grandTotalPrice = grandTotalPrice + (sale.price or 0)
            if sale.iconUrl and sale.iconUrl ~= "" then
                lastIconUrl = sale.iconUrl
            end
            
            if not itemSummary[sale.itemName] then
                itemSummary[sale.itemName] = {
                    amount = sale.amount or 1,
                    price = sale.price or 0
                }
            else
                itemSummary[sale.itemName].amount = itemSummary[sale.itemName].amount + (sale.amount or 1)
                itemSummary[sale.itemName].price = itemSummary[sale.itemName].price + (sale.price or 0)
            end
        end
        
        local itemListLines = {}
        for name, info in pairs(itemSummary) do
            table.insert(itemListLines, string.format("%s x%d", name, info.amount))
        end
        local nameValueText = table.concat(itemListLines, "\n")
        
        local curDiamonds = getPlayerDiamonds()
        local sold1H = getSalesCount1H()
        local sold24H = getSalesCount24H()
        local gems1H = getGems1H()
        local gems24H = getGems24H()
        
        local payload = HttpService:JSONEncode({
            embeds = {
                {
                    title = "Item sold successfully!",
                    color = 5814783,
                    fields = {
                        { name = "Item Name", value = nameValueText, inline = true },
                        { name = "Sell Price", value = formatNumber(grandTotalPrice) .. " Gems", inline = true },
                        { name = "Player", value = LocalPlayer.Name .. " (" .. LocalPlayer.DisplayName .. ")", inline = false },
                        { name = "Gems Owned", value = formatNumber(curDiamonds) .. " 💎", inline = true },
                        { name = "Amount Sold", value = tostring(sold1H) .. " items / hour\n" .. tostring(sold24H) .. " items / day", inline = true },
                        { name = "Gems Earned", value = "+" .. formatNumber(gems1H) .. " / hour\n+" .. formatNumber(gems24H) .. " / day", inline = true }
                    },
                    thumbnail = {
                        url = lastIconUrl or getAssetThumbnailUrl(14293722239)
                    },
                    footer = {
                        text = "Auto Sell | Time: " .. os.date("%H:%M:%S")
                    }
                }
            }
        })
        
        local req = getHttpRequestFunc()
        if req then
            req({
                Url = webhookURL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = payload
            })
            print("[WEBHOOK] Batched Webhook notification sent successfully!")
        else
            print("[WEBHOOK] Executor does not support HTTP requests!")
        end
    end)
end

local function queueSaleForWebhook(itemName, amount, price, iconUrl)
    table.insert(pendingWebhookSales, {
        itemName = itemName,
        amount = amount,
        price = price,
        iconUrl = iconUrl
    })
    
    if not isWebhookBatchScheduled then
        isWebhookBatchScheduled = true
        task.spawn(function()
            task.wait(3)
            processBatchWebhook()
        end)
    end
end

-- Lắng nghe sự kiện bán hàng từ PS99
Network.Fired("Booths: Add History"):Connect(function(saleLog)
    local success, err = pcall(function()
        if not saleLog or not getgenv().PlazaSellConfig then return end
        
        local Types = require(Library:WaitForChild("Items"):WaitForChild("Types"))
        local received = Types.DecodeUnpacked(saleLog.Received)
        local given = Types.DecodeUnpacked(saleLog.Given)
        
        local price = 0
        local soldItem = nil
        local isSale = true
        
        for _, item in ipairs(received) do
            if item:IsA("Currency") then
                price = math.max(price, item:GetAmount() or 0)
            else
                soldItem = item
                isSale = false
            end
        end
        
        for _, item in ipairs(given) do
            if item:IsA("Currency") then
                price = math.max(price, item:GetAmount() or 0)
            else
                soldItem = item
            end
        end
        
        if not soldItem or not isSale then return end
        
        local itemName = soldItem:GetName()
        local amount = soldItem:GetAmount() or 1
        
        print(string.format("[SALE NOTIFY] Sold: %s x%d for %s Gems", itemName, amount, formatNumber(price)))
        
        local itemCfg = getItemConfig(itemName, soldItem)
        if itemCfg then
            if itemCfg.Amount and itemCfg.Amount ~= "All" then
                local num = tonumber(itemCfg.Amount)
                if num then
                    local newQty = math.max(0, num - amount)
                    itemCfg.Amount = (newQty <= 0) and 0 or newQty
                end
            end
            if itemCfg.Limit and itemCfg.Limit ~= "All" then
                local num = tonumber(itemCfg.Limit)
                if num then
                    local newLimit = math.max(0, num - 1)
                    itemCfg.Limit = (newLimit <= 0) and 0 or newLimit
                end
            end
        end
        
        recordSale(itemName, price, amount)
        
        getgenv().PlazaSellListedCache = nil
        if getgenv().PlazaSellSlotCache and getgenv().PlazaSellSlotCache > 0 then
            getgenv().PlazaSellSlotCache = math.max(0, getgenv().PlazaSellSlotCache - 1)
        end
        
        local iconUrl = nil
        local iconAsset = soldItem:GetIcon()
        if iconAsset then
            iconUrl = getAssetThumbnailUrl(iconAsset)
        end
        if not iconUrl or iconUrl == "" then
            iconUrl = getAssetThumbnailUrl(14293722239)
        end
        
        queueSaleForWebhook(itemName, amount, price, iconUrl)
    end)
    if not success then
        warn("[WEBHOOK ERROR] Error processing Booths: Add History:", err)
    end
end)

