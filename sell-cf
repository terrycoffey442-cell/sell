local function getHttpRequestFunc()
    local env = (typeof(getgenv) == "function" and getgenv()) or getfenv()
    local synTable = rawget(env, "syn") or rawget(_G, "syn")
    if typeof(synTable) == "table" and typeof(synTable.request) == "function" then
        return synTable.request
    end
    local httpTable = rawget(env, "http") or rawget(_G, "http")
    if typeof(httpTable) == "table" and typeof(httpTable.request) == "function" then
        return httpTable.request
    end
    local httpReq = rawget(env, "http_request") or rawget(_G, "http_request")
    if typeof(httpReq) == "function" then
        return httpReq
    end
    local req = rawget(env, "request") or rawget(_G, "request")
    if typeof(req) == "function" then
        return req
    end
    return nil
end

local function parseNumber(str)
    if not str then return nil end
    if type(str) == "number" then return math.floor(str) end
    str = tostring(str):lower():gsub("%s+", ""):gsub(",", "")
    local multiplier = 1
    if str:find("k$") then
        multiplier = 1e3
        str = str:sub(1, -2)
    elseif str:find("m$") then
        multiplier = 1e6
        str = str:sub(1, -2)
    elseif str:find("b$") then
        multiplier = 1e9
        str = str:sub(1, -2)
    elseif str:find("t$") then
        multiplier = 1e12
        str = str:sub(1, -2)
    end
    local num = tonumber(str)
    return num and math.floor(num * multiplier) or nil
end

local function formatNumber(num)
    if not num then return "0" end
    if num >= 1e12 then
        return string.format("%.2ft", num / 1e12):gsub("%.00t", "t"):gsub("%.([0-9])0t", ".%1t")
    elseif num >= 1e9 then
        return string.format("%.2fb", num / 1e9):gsub("%.00b", "b"):gsub("%.([0-9])0b", ".%1b")
    elseif num >= 1e6 then
        return string.format("%.2fm", num / 1e6):gsub("%.00m", "m"):gsub("%.([0-9])0m", ".%1m")
    elseif num >= 1e3 then
        return string.format("%.2fk", num / 1e3):gsub("%.00k", "k"):gsub("%.([0-9])0k", ".%1k")
    end
    return tostring(num)
end

local function normalizeOption(val)
    if val == nil then return "All" end
    if type(val) == "string" and val:lower() == "all" then return "All" end
    local num = parseNumber(val)
    return num or val
end

