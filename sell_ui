Network.Fired("Booths: Add History"):Connect(function(entry)
    if not entry then return end

    local receivedDiamonds = 0
    local soldItemsList = {}

    local decodedOk = false
    if Types and type(Types.DecodeUnpacked) == "function" then
        pcall(function()
            local received = Types.DecodeUnpacked(entry.Received)
            local given = Types.DecodeUnpacked(entry.Given)
            local isSale = true

            for _, item in ipairs(received or {}) do
                if type(item.IsA) == "function" and item:IsA("Currency") then
                    receivedDiamonds = math.max(receivedDiamonds, (type(item.GetAmount) == "function" and item:GetAmount()) or 0)
                else
                    isSale = false
                end
            end

            if isSale then
                for _, item in ipairs(given or {}) do
                    if not (type(item.IsA) == "function" and item:IsA("Currency")) then
                        local uid = type(item.GetUID) == "function" and item:GetUID() or nil
                        local meta = uid and listedMetaCache[uid] or nil
                        local itemName = (meta and meta.FullName) or (type(item.GetName) == "function" and item:GetName()) or "Huge Pet"
                        local assetId, rbxAssetId, thumbUrl = ExtractAssetInfo(item, nil)
                        if meta and meta.AssetId and meta.AssetId ~= "N/A" then
                            assetId = meta.AssetId
                            rbxAssetId = meta.RbxAssetId
                            thumbUrl = meta.ThumbUrl
                        end
                        if uid then
                            myListingsCache[uid] = nil
                            listedMetaCache[uid] = nil
                        end
                        table.insert(soldItemsList, {
                            Name = itemName,
                            AssetId = assetId,
                            RbxAssetId = rbxAssetId,
                            ThumbUrl = thumbUrl,
                            Meta = meta
                        })
                    end
                end
            end
            decodedOk = true
        end)
    end

    if not decodedOk then
        if entry.Received and entry.Received.Currency then
            for _, cur in pairs(entry.Received.Currency) do
                if cur.id == "Diamonds" then
                    receivedDiamonds = receivedDiamonds + (cur._am or 0)
                end
            end
        end
        if entry.Given and entry.Given.Pet then
            for _, pet in pairs(entry.Given.Pet) do
                local uid = pet._uid
                local meta = uid and listedMetaCache[uid] or nil
                local assetId, rbxAssetId, thumbUrl = ExtractAssetInfo(nil, pet)
