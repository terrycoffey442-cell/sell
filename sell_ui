local function ScanEligibleHugePets(activeListings, maxNeeded)
    local save = Save.Get()
    if not (save and save.Inventory and save.Inventory.Pet) then
        return {}
    end

    local eligible = {}
    local needed = maxNeeded or 25
    local maxBuffer = math.min(needed * 2, 50)

    for uid, pData in pairs(save.Inventory.Pet) do
        if not activeListings[uid] and not pData.l and not pData._lk and not (pData._am and pData._am <= 0) then
            local id = pData.id

            if type(id) == "string" and (id:find("Huge") or id:find("Titanic") or id:find("Gargantuan")) then
                local cosmicVal, cosmicDemand, demandScale, fullName = FetchExternalCosmic(pData)

                if cosmicVal and cosmicDemand ~= nil and cosmicVal >= Config.MinPrice then
                    local targetPrice = math.floor(cosmicVal * (1 - (Config.UnderPercent / 100)))
                    targetPrice = math.max(targetPrice, Config.MinPrice)

                    local itemObj = AbstractItem:Get(uid)
                    local assetId, rbxAssetId, thumbUrl = ExtractAssetInfo(itemObj, pData)

                    local entryData = {
                        UID = uid,
                        Id = id,
                        FullName = fullName or id,
                        BaseValue = cosmicVal,
                        TargetPrice = targetPrice,
                        Demand = cosmicDemand,
                        DemandScale = demandScale or math.round(cosmicDemand * 10),
                        Source = "CosmicWeb",
                        IsShiny = pData.sh == true,
                        Pt = pData.pt,
                        AssetId = assetId,
                        RbxAssetId = rbxAssetId,
                        ThumbUrl = thumbUrl
                    }

                    if #eligible < maxBuffer then
                        table.insert(eligible, entryData)
                    elseif Config.SortOrder == "LowestPrice" then
                        local worstIdx = 1
                        local worstPrice = eligible[1].TargetPrice
                        for idx = 2, #eligible do
                            if eligible[idx].TargetPrice > worstPrice then
                                worstPrice = eligible[idx].TargetPrice
                                worstIdx = idx
                            end
                        end
                        if targetPrice < worstPrice then
                            eligible[worstIdx] = entryData
                        end
                    end
                end
            end
        end
    end

    if Config.SortOrder == "HighestDemand" then
        table.sort(eligible, function(a, b)
            if a.Demand == b.Demand then
                return a.TargetPrice < b.TargetPrice
            end
            return a.Demand > b.Demand
        end)
    elseif Config.SortOrder == "LowestPrice" then
        table.sort(eligible, function(a, b)
            return a.TargetPrice < b.TargetPrice
        end)
    elseif Config.SortOrder == "HighestPrice" then
        table.sort(eligible, function(a, b)
            return a.TargetPrice > b.TargetPrice
        end)
    end

    return eligible
end

