local function HttpGetUrl(url)
    local ok, res = pcall(function()
        return game:HttpGet(url)
    end)
    if ok and type(res) == "string" and #res > 0 then
        return res
    end
    local reqFn = GetHttpRequestFn()
    if reqFn then
        local reqOk, reqRes = pcall(function()
            return reqFn({ Url = url, Method = "GET" })
        end)
        if reqOk and reqRes and type(reqRes.Body) == "string" then
            return reqRes.Body
        end
    end
    return nil
end

local function ParseCosmicNumber(str)
    if type(str) == "number" then
        return math.floor(str)
    end
    if type(str) ~= "string" then
        return nil
    end
    local cleaned = str:upper():gsub("%s+", ""):gsub(",", "")
    if cleaned == "" or cleaned == "SOON" or cleaned == "N/A" or cleaned == "O/C" then
        return nil
    end
    local mult = 1
    if cleaned:sub(-1) == "K" then
        mult = 1e3
        cleaned = cleaned:sub(1, -2)
    elseif cleaned:sub(-1) == "M" then
        mult = 1e6
        cleaned = cleaned:sub(1, -2)
    elseif cleaned:sub(-1) == "B" then
        mult = 1e9
        cleaned = cleaned:sub(1, -2)
    elseif cleaned:sub(-1) == "T" then
        mult = 1e12
        cleaned = cleaned:sub(1, -2)
    end
    local num = tonumber(cleaned)
    if not num or num <= 0 then
        return nil
    end
    return math.floor(num * mult)
end

local function ParseCosmicDemand(str)
    if type(str) == "number" then
        return str, math.round(str * 10)
    end
    if type(str) ~= "string" then
        return nil, nil
    end
    local numStr = str:match("^(%d+%.?%d*)%s*/%s*10$") or str:match("^(%d+%.?%d*)$")
    local scale = tonumber(numStr)
    if not scale then
        return nil, nil
    end
    return scale / 10, math.round(scale)
end

local function BuildCosmicQueryName(pData)
    local prefix = ""
    if pData.sh == true then
        prefix = prefix .. "Shiny "
    end
    if pData.pt == 1 then
        prefix = prefix .. "Golden "
    elseif pData.pt == 2 then
        prefix = prefix .. "Rainbow "
    end
    return prefix .. tostring(pData.id)
end

local function FetchExternalCosmic(pData)
    local queryName = BuildCosmicQueryName(pData)
    local now = os.clock()
    local cached = cosmicWebCache[queryName]
    if cached and (now - cached.fetchedAt) < COSMIC_CACHE_TTL then
        return cached.value, cached.demand, cached.demandScale, queryName
    end

    local url = "https://petsimulatorvalues.com/values.php?item=" .. HttpService:UrlEncode(queryName)
    local raw = HttpGetUrl(url)
    if not raw then
        return nil, nil, nil, queryName
    end

    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    local itemData = ok and type(decoded) == "table" and decoded.item or nil
    local cosmicVal = itemData and ParseCosmicNumber(itemData.value) or nil
    local cosmicDemand, demandScale = nil, nil
    if itemData then
        cosmicDemand, demandScale = ParseCosmicDemand(itemData.demand)
    end

    cosmicWebCache[queryName] = {
        value = cosmicVal,
        demand = cosmicDemand,
        demandScale = demandScale,
        rawValue = itemData and itemData.value or "N/A",
        rawDemand = itemData and itemData.demand or "N/A",
        fetchedAt = now
    }

    if cosmicVal and demandScale then
        print(string.format("[SellHugeCV] Cosmic fetched: %s -> Value: %s | Demand: %d/10",
            queryName, FormatNumber(cosmicVal), demandScale))
    else
        print(string.format("[SellHugeCV] Cosmic skipped (unpriced): %s -> Value: %s | Demand: %s",
            queryName, tostring(itemData and itemData.value or "nil"), tostring(itemData and itemData.demand or "nil")))
    end

    return cosmicVal, cosmicDemand, demandScale, queryName
end

local function ExtractAssetInfo(itemObj, pData)
    local rawIcon = nil
    if itemObj and type(itemObj.GetIcon) == "function" then
        pcall(function()
            rawIcon = itemObj:GetIcon()
        end)
    end
    if not rawIcon and pData and Types and Types.From then
        pcall(function()
            local tempItem = Types.From("Pet", pData)
            if tempItem and type(tempItem.GetIcon) == "function" then
                rawIcon = tempItem:GetIcon()
            end
        end)
    end
    local numericId = rawIcon and tostring(rawIcon):match("%d+") or nil
    local rbxAssetStr = numericId and ("rbxassetid://" .. numericId) or tostring(rawIcon or "N/A")
    local thumbUrl = numericId and ("https://biggamesapi.io/image/" .. numericId) or ""
    return numericId or "N/A", rbxAssetStr, thumbUrl
end

