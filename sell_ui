local isTeleporting = false
local function EnsureInTradingPlaza()
    if IsInTradingPlaza() then
        return true
    end

    if not Config.AutoJoinTrading then
        warn("[SellHugeCV] Player is not in Trading Plaza and AutoJoinTrading is disabled")
        return false
    end

    if isTeleporting then
        return false
    end
    isTeleporting = true

    print("[SellHugeCV] Main world detected. Preparing teleport to Trading Plaza...")

    local normalId = 15502339080
    local proId = 15588442388
    if PlaceFile and PlaceFile.LocalPlaces then
        normalId = PlaceFile.LocalPlaces.Trading or normalId
        proId = PlaceFile.LocalPlaces.ProTrading or proId
    end

    local targetPlaceId = normalId
    if Config.PlazaType == "Pro Plaza" then
        targetPlaceId = proId
    elseif Config.PlazaType == "Normal Plaza" then
        targetPlaceId = normalId
    else
        if TradingPlazaCmds and TradingPlazaCmds.GetAvailable then
            local ok, av = pcall(function() return TradingPlazaCmds.GetAvailable() end)
            if ok and av and #av > 0 then
                local chosen = av[1]
                for _, p in ipairs(av) do
                    if p.PlaceId == proId then
                        chosen = p
                        break
                    end
                end
                targetPlaceId = chosen.PlaceId or normalId
            end
        end
    end

    print(string.format("[SellHugeCV] Requesting teleport to Trading Plaza (PlaceId: %d)...", targetPlaceId))
    task.wait(1.0)

    local teleported = false
    if TradingPlazaCmds and TradingPlazaCmds.RequestTradingPlaza then
        local ok = pcall(function()
            TradingPlazaCmds.RequestTradingPlaza(targetPlaceId)
        end)
        if ok then teleported = true end
    end

    if not teleported then
        pcall(function()
            Network.Invoke("Travel to Trading Plaza", targetPlaceId)
        end)
    end

    task.wait(5.0)
    isTeleporting = false
    return false
end

local function EnsureBoothClaimed()
    if GetMyClaimedBoothModel() then
        return true
    end

    if not Config.AutoClaimBooth then
        warn("[SellHugeCV] Player has no claimed booth and AutoClaimBooth is disabled")
        return false
    end

    if Signal and Signal.Invoke then
        local loaded = false
        for _ = 1, 40 do
            local ok, res = pcall(function() return Signal.Invoke("Booths_IsLoaded") end)
            if ok and res == true then
                loaded = true
                break
            end
            task.wait(0.5)
        end
        if not loaded then
            warn("[SellHugeCV] Booths system is still initializing, waiting...")
        end
    end

    if GetMyClaimedBoothModel() then
        return true
    end

    print("[SellHugeCV] LocalPlayer has no booth. Attempting to claim any available booth...")

    local activeBooths = {}
    pcall(function()
        activeBooths = Signal.Invoke("Booths_Get_Active") or {}
    end)
    local placeholders = {}
    pcall(function()
        placeholders = Signal.Invoke("Booths_Get_Placeholder") or {}
    end)

    local availableIds = {}
    for idStr, _ in pairs(placeholders) do
        if not activeBooths[idStr] then
            table.insert(availableIds, tostring(idStr))
        end
    end

    if #availableIds == 0 then
        for i = 1, 50 do
            local idStr = tostring(i)
            if not activeBooths[idStr] then
                table.insert(availableIds, idStr)
            end
        end
    end

    for _, idStr in ipairs(availableIds) do
        local claimOk, claimRes = pcall(function()
            return Network.Invoke("Booths_ClaimBooth", idStr)
        end)
        if claimOk and claimRes then
            print(string.format("[SellHugeCV] Successfully claimed booth ID: %s", idStr))
            task.wait(1.0)
            return true
        end
        task.wait(0.1)
    end

    warn("[SellHugeCV] Failed to claim any booth in this server (all occupied or throttled)")
    return false
end

