                    AssetId = (meta and meta.AssetId) or assetId,
                    RbxAssetId = (meta and meta.RbxAssetId) or rbxAssetId,
                    ThumbUrl = (meta and meta.ThumbUrl) or thumbUrl,
                    Meta = meta
                })
            end
        end
    end

    if #soldItemsList > 0 then
        local namesList = {}
        local assetList = {}
        local primaryThumb = ""
        for _, sItem in ipairs(soldItemsList) do
            table.insert(namesList, sItem.Name)
            table.insert(assetList, string.format("%s (%s)", tostring(sItem.AssetId), tostring(sItem.RbxAssetId)))
            if primaryThumb == "" and sItem.ThumbUrl and sItem.ThumbUrl ~= "" then
                primaryThumb = sItem.ThumbUrl
            end
        end

        local namesStr = table.concat(namesList, ", ")
        local assetsStr = table.concat(assetList, "\n")
        print(string.format("[SellHugeCV] SALE RECORDED: Sold %s (AssetId: %s) for %s Gems!",
            namesStr, tostring(soldItemsList[1].AssetId), FormatNumber(receivedDiamonds)))

        SendWebhookLog("Huge Sold from Booth", {
            { name = "Pet(s)", value = namesStr, inline = true },
            { name = "Gems Received", value = FormatNumber(receivedDiamonds) .. " Gems", inline = true },
            { name = "Asset ID", value = assetsStr, inline = false },
            { name = "Current Diamonds", value = FormatNumber(GetPlayerDiamonds()) .. " Gems", inline = true },
            { name = "Buyer UserId", value = tostring(entry.OtherUserId or "N/A"), inline = true }
        }, primaryThumb, 5814783)

        lastSaleTime = os.clock()
        triggerImmediateCycle = true
    end
end)

local function RunListingCycle()
    if not Config.Enabled then
        return
    end

    if not IsInTradingPlaza() then
        EnsureInTradingPlaza()
        return
    end

    local boothClaimed = EnsureBoothClaimed()
    if boothClaimed ~= true then
        return
    end

    local activeListings = GetMyActiveListings()
    local currentListingCount = CountActiveListings(activeListings)
    local maxSlots = GetMaxAllowedSlots()
    local freeSlots = maxSlots - currentListingCount

    if freeSlots <= 0 then
        return
    end

    local eligiblePets = ScanEligibleHugePets(activeListings, freeSlots)
    if #eligiblePets == 0 then
        return
    end

    print(string.format("[SellHugeCV] Scan: %d active listings / %d max slots (%d free). Found %d eligible Huge pets.",
        currentListingCount, maxSlots, freeSlots, #eligiblePets))

    local toListCount = math.min(freeSlots, #eligiblePets)

    for i = 1, toListCount do
        if not Config.Enabled then break end

        local target = eligiblePets[i]

        local itemObj = AbstractItem:Get(target.UID)
        if not itemObj then continue end
        if type(itemObj.GetAmount) == "function" and itemObj:GetAmount() < 1 then
            activeListings[target.UID] = true
            continue
        end
        if type(itemObj.IsLocked) == "function" and itemObj:IsLocked() then
            activeListings[target.UID] = true
            continue
        end
        if type(itemObj.IsEquipped) == "function" and itemObj:IsEquipped() then
            continue
        end
        if type(itemObj.IsTradable) == "function" and not itemObj:IsTradable() then
            continue
        end

        local ok, res, errDetail = pcall(function()
            return Network.Invoke("Booths_CreateListing", target.UID, target.TargetPrice, 1)
        end)

        if ok and res then
            print(string.format("[SellHugeCV] LISTED SUCCESS: %s (AssetId: %s) | Price: %s Gems (CV: %s, -%d%%, Demand: %d/10)",
                target.FullName or target.Id,
                tostring(target.AssetId),
                FormatNumber(target.TargetPrice),
                FormatNumber(target.BaseValue),
                Config.UnderPercent,
                target.DemandScale
            ))
            activeListings[target.UID] = true
            myListingsCache[target.UID] = true
            listedMetaCache[target.UID] = target
            currentListingCount = currentListingCount + 1

            SendWebhookLog("Huge Listed on Booth", {
                { name = "Pet", value = target.FullName or target.Id, inline = true },
                { name = "Listed Price", value = FormatNumber(target.TargetPrice) .. " Gems", inline = true },
                { name = "Cosmic Value", value = string.format("%s (-%d%% | Demand: %d/10)", FormatNumber(target.BaseValue), Config.UnderPercent, target.DemandScale), inline = false },
                { name = "Asset ID", value = string.format("%s (%s)", tostring(target.AssetId), tostring(target.RbxAssetId)), inline = false },
                { name = "Booth Slots", value = string.format("%d / %d", currentListingCount, maxSlots), inline = true }
            }, target.ThumbUrl, 65280)
        else
            local errStr = tostring(errDetail or res or "Unknown"):lower()
            warn(string.format("[SellHugeCV] LIST FAILED for %s: %s", target.FullName or target.Id, errStr))

            if errStr:find("fast") or errStr:find("too") or errStr:find("cooldown") or errStr:find("later") then
                print("[SellHugeCV] Rate limit / cooldown hit. Pausing 5.0 seconds...")
                task.wait(5.0)
                break
            elseif errStr:find("slot") or errStr:find("full") or errStr:find("max") then
                print("[SellHugeCV] Booth slot limit reached. Ending cycle.")
                break
            elseif errStr:find("enough") then
                activeListings[target.UID] = true
            end
        end

        if i < toListCount and Config.ListingDelay > 0 then
            task.wait(Config.ListingDelay)
        end
    end
end

task.spawn(function()
    print("[SellHugeCV] Auto Sell Huge CV Engine started successfully.")
    while getgenv().SellHugeCV_Running do
        if Config.Enabled then
            RunListingCycle()
        end

        local waitElapsed = 0
        local checkStep = 0.5
        while waitElapsed < Config.CycleInterval do
            if triggerImmediateCycle then

                local elapsedSinceSale = os.clock() - lastSaleTime
                if elapsedSinceSale < 2.5 then
                    task.wait(2.5 - elapsedSinceSale)
                end
                triggerImmediateCycle = false
                print("[SellHugeCV] Fast refill triggered by sale event.")
                break
            end
            task.wait(checkStep)
            waitElapsed = waitElapsed + checkStep
        end
    end
end)

local moduleApi = {
    Config = Config,
    RunCycle = RunListingCycle,
    ScanPets = ScanEligibleHugePets,
    GetMyActiveListings = GetMyActiveListings
}
getgenv().SellHugeCV_Module = moduleApi
return moduleApi
