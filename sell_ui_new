        local data = Save and Save.Get and Save.Get()
        if data then
            if data.Inventory and type(data.Inventory.Currency) == "table" then
                local total = 0
                for _, cur in pairs(data.Inventory.Currency) do
                    if type(cur) == "table" and cur.id == "Diamonds" then
                        total = total + (tonumber(cur._am) or 1)
                    end
                end
                if total > 0 then return total end
            end
            if data.Currency and type(data.Currency.Diamonds) == "number" then
                return data.Currency.Diamonds
            elseif type(data.Diamonds) == "number" then
                return data.Diamonds
            end
        end
    end)
    if success and type(count) == "number" then return count end

    -- Check leaderstats làm phương án dự phòng
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    local diamonds = leaderstats and (leaderstats:FindFirstChild("Diamonds") or leaderstats:FindFirstChild("Gems"))
    if diamonds then
        local val = tostring(diamonds.Value):gsub(",", ""):match("%d+")
        return tonumber(val) or 0
    end
    return 0
end
