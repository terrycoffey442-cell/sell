local function getPlazaPlaceIds()
    local normalId = 15502339080
    local proId = 15588442388
    local PlaceFile = getModule("Modules", "PlaceFile")
    if PlaceFile and PlaceFile.LocalPlaces then
        normalId = PlaceFile.LocalPlaces.Trading or normalId
        proId = PlaceFile.LocalPlaces.ProTrading or proId
    end
    return normalId, proId
end

local function isOnTradingPlaza()
    local TradingPlazaCmds = getModule("Client", "TradingPlazaCmds")
    if TradingPlazaCmds and type(TradingPlazaCmds.IsOnTradingPlaza) == "function" then
        local ok, res = pcall(TradingPlazaCmds.IsOnTradingPlaza)
        if ok and res ~= nil then
            return res == true
        end
    end
    local normalId, proId = getPlazaPlaceIds()
    return game.PlaceId == normalId or game.PlaceId == proId or workspace:FindFirstChild("TradingPlaza") ~= nil
end

local function hasProPlazaAccess(saveData)
    if type(saveData) ~= "table" then return false, 0, 0, 0 end
    local rebirths = tonumber(saveData.Rebirths) or 0
    if not saveData.CastleUnlocked or rebirths < 1 then
        return false, 0, 0, 0
    end
    local hugeCount, titanicCount, gargCount = 0, 0, 0
    local petInv = saveData.Inventory and saveData.Inventory.Pet
    if type(petInv) == "table" then
        for _, pData in pairs(petInv) do
            if type(pData) == "table" then
                local idStr = tostring(pData.id or "")
                local amt = tonumber(pData._am) or 1
                if idStr:find("Gargantuan") then
                    gargCount = gargCount + amt
                elseif idStr:find("Titanic") then
                    titanicCount = titanicCount + amt
                elseif idStr:find("Huge") then
                    hugeCount = hugeCount + amt
                end
            end
        end
    end
    return (hugeCount >= 50 or titanicCount >= 5 or gargCount >= 1), hugeCount, titanicCount, gargCount
end

local function checkAndTeleport()
    local config = getgenv().PlazaSellConfig
    if not config or not config.Enabled or not config.AutoTeleport then return end
    if isOnTradingPlaza() then return end

    local now = os.clock()
    if State.IsTeleporting or (now - (State.LastTeleportAttempt or 0)) < 15 then
        return
    end

    local Save = getModule("Client", "Save")
    local okSave, saveData = false, nil
    if Save and type(Save.Get) == "function" then
        okSave, saveData = pcall(Save.Get)
    end
    if not okSave or type(saveData) ~= "table" then
        return
    end

    -- Kiểm tra điều kiện mở khóa Trading Plaza (tránh spam teleport khi chưa Rebirth hoặc chưa mở Castle)
    local rebirths = tonumber(saveData.Rebirths) or 0
    if not saveData.CastleUnlocked or rebirths < 1 then
        State.LastTeleportAttempt = now
        if (now - (State.LastLockWarnAt or 0)) >= 60 then
            State.LastLockWarnAt = now
            warn(string.format("[TELEPORT] Trading Plaza locked (CastleUnlocked=%s, Rebirths=%d). Skipping teleport.", tostring(saveData.CastleUnlocked), rebirths))
        end
        return
    end

    local normalId, proId = getPlazaPlaceIds()
    local targetPlaceId = normalId

    -- Per user: "Auto Select" ưu tiên Normal Plaza (15502339080)
    if config.PlazaType == "Pro Plaza" then
        local canPro, hugeCount, titanicCount, gargCount = hasProPlazaAccess(saveData)
        if canPro then
            targetPlaceId = proId
        else
            targetPlaceId = normalId
            if (now - (State.LastProWarnAt or 0)) >= 60 then
                State.LastProWarnAt = now
                warn(string.format("[TELEPORT] Pro Plaza requirements not met (Huges=%d/50, Titanics=%d/5, Garg=%d/1). Falling back to Normal Plaza.", hugeCount, titanicCount, gargCount))
            end
        end
    end

    State.IsTeleporting = true
    State.LastTeleportAttempt = now
    print(string.format("[TELEPORT] Main world detected. Requesting Travel to Trading Plaza (%d)...", targetPlaceId))

    local ok, res, errMsg = pcall(function()
        return Network.Invoke("Travel to Trading Plaza", targetPlaceId)
    end)

    if (not ok or not res) and targetPlaceId == proId then
        warn(string.format("[TELEPORT] Pro Plaza rejected (%s). Falling back to Normal Plaza (%d)...", tostring(errMsg or res), normalId))
        local okFb, resFb = pcall(function()
            return Network.Invoke("Travel to Trading Plaza", normalId)
        end)
        if not okFb then
            warn("[TELEPORT] Normal Plaza fallback error:", tostring(resFb))
        end
    elseif not ok then
        warn("[TELEPORT] Travel to Trading Plaza failed:", tostring(res))
    end

    State.IsTeleporting = false
end

local function serverHop()
    local config = getgenv().PlazaSellConfig
    if not config or not config.AutoHop then return end
    if State.IsHopping then return end
    State.IsHopping = true

    print("[SYSTEM] Attempting to Auto Server Hop...")
    local normalId, proId = getPlazaPlaceIds()
    -- Auto Select và Normal Plaza resolve về normalId (15502339080); Pro Plaza kiểm tra điều kiện thực tế trước khi hop
    local targetPlaceId = normalId
    if config.PlazaType == "Pro Plaza" then
        local Save = getModule("Client", "Save")
        local okSave, saveData = false, nil
        if Save and type(Save.Get) == "function" then
            okSave, saveData = pcall(Save.Get)
        end
        if okSave and hasProPlazaAccess(saveData) then
            targetPlaceId = proId
        end
    end

    local servers = {}
    local req = getHttpRequestFn()
    if req then
        local success, res = pcall(function()
            return req({
                Url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100", targetPlaceId),
                Method = "GET"
            })
        end)
        if success and res and type(res.Body) == "string" and #res.Body > 0 then
            local okDec, decoded = pcall(function()
                return HttpService:JSONDecode(res.Body)
            end)
            if okDec and type(decoded) == "table" and type(decoded.data) == "table" then
                for _, srv in ipairs(decoded.data) do
                    if type(srv) == "table" and srv.playing and srv.maxPlayers and srv.playing < srv.maxPlayers - 2 and srv.id ~= game.JobId then
                        table.insert(servers, srv)
                    end
                end
            elseif not okDec then
                warn("[SYSTEM] ServerHop JSONDecode error:", tostring(decoded))
            end
        elseif not success then
            warn("[SYSTEM] ServerHop HTTP request failed:", tostring(res))
        end
    end

    local TS = (type(cloneref) == "function" and cloneref(game:GetService("TeleportService"))) or game:GetService("TeleportService")
    if #servers > 0 then
        local target = servers[math.random(1, #servers)]
        print("[SYSTEM] Hopping to server:", target.id)
        local okTp, errTp = pcall(function()
            TS:TeleportToPlaceInstance(targetPlaceId, target.id, LocalPlayer)
        end)
        if not okTp then
            warn("[SYSTEM] TeleportToPlaceInstance failed:", tostring(errTp))
            local okFb, errFb = pcall(function()
                TS:Teleport(targetPlaceId, LocalPlayer)
            end)
            if not okFb then
                warn("[SYSTEM] Fallback Teleport failed:", tostring(errFb))
            end
        end
    else
        print("[SYSTEM] No suitable servers found. Rejoining random server...")
        local okTp, errTp = pcall(function()
            TS:Teleport(targetPlaceId, LocalPlayer)
        end)
        if not okTp then
            warn("[SYSTEM] Random Teleport failed:", tostring(errTp))
        end
    end

    task.delay(10, function()
        State.IsHopping = false
    end)
end
