local function getMaxBoothSlots(saveData, config)
    local fflagMax = 50
    pcall(function()
        local FFlags = getModule("Client", "FFlags") or getModule("Universal", "FFlags")
        if FFlags and type(FFlags.Get) == "function" and type(FFlags.Keys) == "table" and FFlags.Keys.BoothMaxSlots then
            local val = FFlags.Get(FFlags.Keys.BoothMaxSlots)
            if type(val) == "number" then
                fflagMax = val
            end
        end
    end)
    local fflagCap = math.clamp(math.floor(fflagMax or 50), 4, 100)
    local unlockedSlots = (saveData and tonumber(saveData.BoothSlots)) or 4
    local cfgSlots = tonumber(config and config.MaxSlots) or 50
    return math.max(1, math.min(cfgSlots, unlockedSlots, fflagCap))
end

local function getEquippedPetCounts(saveData)
    local counts = {}
    pcall(function()
        local PetNetworking = getModule("Client", "PetNetworking")
        local eqTable = nil
        if PetNetworking and type(PetNetworking.EquippedPets) == "function" then
            local okEq, resEq = pcall(PetNetworking.EquippedPets)
            if okEq and type(resEq) == "table" then
                eqTable = resEq
            end
        end
        if not eqTable and saveData and type(saveData.EquippedPets) == "table" then
            eqTable = saveData.EquippedPets
        end
        if type(eqTable) == "table" then
            for k, v in pairs(eqTable) do
                if type(v) == "string" then
                    counts[v] = (counts[v] or 0) + 1
                elseif type(v) == "table" then
                    local eqUid = nil
                    if type(v.GetUID) == "function" then
                        local okU, u = pcall(v.GetUID, v)
                        if okU and u then eqUid = tostring(u) end
                    end
                    eqUid = eqUid or v.uid or v._uid or v.euid
                    if eqUid then
                        local key = tostring(eqUid)
                        counts[key] = (counts[key] or 0) + 1
                    elseif type(k) == "string" then
                        counts[k] = (counts[k] or 0) + 1
                    end
                elseif v == true and type(k) == "string" then
                    counts[k] = (counts[k] or 0) + 1
                elseif type(v) == "number" and type(k) == "string" then
                    counts[k] = (counts[k] or 0) + math.max(1, math.floor(v))
                end
            end
        end
    end)
    return counts
end

local function claimBestBooth()
    local TradingPlaza = workspace:FindFirstChild("TradingPlaza")
    local BoothSpawns = TradingPlaza and TradingPlaza:FindFirstChild("BoothSpawns")
    local candidates = {}

    if BoothSpawns then
        for _, child in ipairs(BoothSpawns:GetChildren()) do
            local idAttr = child:GetAttribute("ID")
            if idAttr ~= nil then
                table.insert(candidates, {
                    model = child,
                    id = tostring(idAttr),
                    numId = tonumber(idAttr) or 999
                })
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.numId < b.numId
    end)

    if #candidates > 0 then
        print(string.format("[AUTO SELL] Found %d empty booth spawns.", #candidates))
        for _, candidate in ipairs(candidates) do
            if not isSessionActive() then return false, nil, "stopped" end
            if candidate.model.Parent == BoothSpawns then
                pcall(function()
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        LocalPlayer.Character:PivotTo(candidate.model:GetPivot() * CFrame.new(0, 4.5, 4.5))
                    end
                end)
                task.wait(0.2)

                local invOk, claimRes, claimErr = pcall(function()
                    return Network.Invoke("Booths_ClaimBooth", candidate.id)
                end)
                if invOk and claimRes then
                    print(string.format("[AUTO SELL] Successfully claimed Booth ID: %s", candidate.id))
                    return true, candidate.id, nil
                end

                local reason = tostring(not invOk and claimRes or claimErr or "rejected")
                warn(string.format("[AUTO SELL] Failed to claim Booth ID %s: %s", candidate.id, reason))
                local errLower = reason:lower()
                if errLower:find("already") or errLower:find("own") then
                    local okAct, actModel = pcall(Signal.Invoke, "Booths_GetActiveModel")
                    if okAct and actModel and (typeof(actModel) ~= "Instance" or actModel.Parent ~= nil) then
                        return true, "existing", nil
                    end
                end
                if errLower:find("cooldown") or errLower:find("wait") or errLower:find("later") or errLower:find("fast") or errLower:find("too") then
                    return false, nil, "cooldown"
                end
                task.wait(0.1)
            end
        end
    else
        print("[AUTO SELL] No empty booth spawns in BoothSpawns, attempting Booths_ClaimAnyBooth fallback...")
    end

    -- Fallback: Booths_ClaimAnyBooth
    local okAny, anyRes, anyErr = pcall(function()
        return Network.Invoke("Booths_ClaimAnyBooth")
    end)
    if okAny and anyRes then
        print("[AUTO SELL] Claimed booth via Booths_ClaimAnyBooth fallback.")
        return true, tostring(anyRes), nil
    elseif not okAny then
        warn("[AUTO SELL] Booths_ClaimAnyBooth error:", tostring(anyRes))
    elseif anyErr then
        warn("[AUTO SELL] Booths_ClaimAnyBooth rejected:", tostring(anyErr))
    end

    return false, nil, "failed"
end

local function cloneMap(tbl)
    local copy = {}
    for k, v in pairs(tbl or {}) do
        copy[k] = v
    end
    return copy
end

-- Lấy danh sách UID đang treo: hydrate từ Booths_GetInitialState (.data._am) + Booths_Broadcast + 10s fallback refresh
local function getListedUIDs(forceRefresh)
    local CACHE_TTL = 10
    local now = os.time()

    if not forceRefresh and State.Booth.Hydrated and (now - (State.Booth.LastFetch or 0)) < CACHE_TTL then
        return cloneMap(State.Booth.Listed), State.Booth.Count, cloneMap(State.Booth.SlotsByName), cloneMap(State.Booth.AmtByName)
    end

    local ok, serverStates = pcall(function()
        return Network.Invoke("Booths_GetInitialState")
    end)
    if not ok then
        warn("[AUTO SELL] Booths_GetInitialState failed:", tostring(serverStates))
        return cloneMap(State.Booth.Listed), State.Booth.Count, cloneMap(State.Booth.SlotsByName), cloneMap(State.Booth.AmtByName)
    end

    getgenv().PlazaSellLastStateCall = os.time()
    if type(serverStates) == "table" then
        for k, state in pairs(serverStates) do
            if type(state) == "table" then
                local isMine = false
                if tostring(k) == tostring(LocalPlayer.UserId) then isMine = true end
                local pObj = state.Player or state.Owner or state.player or state.owner
                if pObj == LocalPlayer or (typeof(pObj) == "Instance" and pObj:IsA("Player") and pObj.UserId == LocalPlayer.UserId) then
                    isMine = true
                end
                local pId = state.PlayerID or state.PlayerId or state.UserId or state.OwnerId or state.PlayerUserId
                if pId and tostring(pId) == tostring(LocalPlayer.UserId) then
                    isMine = true
                end

                if isMine then
                    local listed, count, slotsByName, amtByName = parseBoothListings(state.Listings)
                    updateBoothCache(listed, count, slotsByName, amtByName, false)
                    return cloneMap(listed), count, cloneMap(slotsByName), cloneMap(amtByName)
                end
            end
        end
        -- Đã có booth nhưng không có listing nào
        updateBoothCache({}, 0, {}, {}, false)
    end

    return {}, 0, {}, {}
end

local function runAutoSellProcess()
    while isSessionActive() do
        task.wait(10)
        if not isSessionActive() then
            print("[AUTO SELL] New script session detected. Stopping previous Auto Sell thread.")
            break
        end

        local config = getgenv().PlazaSellConfig
        if config and config.Enabled then
            local tickOk, tickErr = pcall(function()
                if not isOnTradingPlaza() then return end

                -- [1] Kiểm tra Global Player Cooldown trước khi làm gì khác
                local globalCooldown = getgenv().PlazaSellGlobalCooldown
                local globalCooldownDur = getgenv().PlazaSellGlobalCooldownDur or 120
                if globalCooldown then
                    local elapsed = os.time() - globalCooldown
                    if elapsed < globalCooldownDur then
                        if elapsed % 30 == 0 or elapsed == 0 then
                            print(string.format("[AUTO SELL] Player cooldown active. Waiting... (%ds / %ds)", elapsed, globalCooldownDur))
                        end
                        return
                    else
                        getgenv().PlazaSellGlobalCooldown = nil
                        getgenv().PlazaSellGlobalCooldownDur = nil
                        getgenv().PlazaSellItemCooldowns = {}
                        State.Booth.Hydrated = false
                        getgenv().PlazaSellListedCache = nil
                        print("[AUTO SELL] Player cooldown expired. Resuming operation...")
                    end
                end

                -- [2] Đảm bảo hệ thống Booth của Plaza đã load xong trước khi đụng BoothSpawns / ActiveModel
                if not isBoothsLoaded() then
                    if (os.clock() - (State.LastBoothLoadWarn or 0)) >= 15 then
                        State.LastBoothLoadWarn = os.clock()
                        print("[AUTO SELL] Booths system not loaded yet. Waiting for next tick...")
                    end
                    return
                end

                -- [3] Đảm bảo đã chiếm booth
                local myBooth = nil
                local okActive, activeModel = pcall(Signal.Invoke, "Booths_GetActiveModel")
                if okActive and activeModel and (typeof(activeModel) ~= "Instance" or activeModel.Parent ~= nil) then
                    myBooth = activeModel
                end
                if not myBooth then
                    local things = workspace:FindFirstChild("__THINGS")
                    local boothsFolder = things and things:FindFirstChild("Booths")
                    if boothsFolder then
                        for _, boothModel in ipairs(boothsFolder:GetChildren()) do
                            local ownerId = boothModel:GetAttribute("Owner")
                            if ownerId and tostring(ownerId) == tostring(LocalPlayer.UserId) then
                                myBooth = boothModel
                                break
                            end
                        end
                    end
                end

                if not myBooth then
                    print("[AUTO SELL] Finding and claiming the best empty booth...")
                    local claimed, boothId, reason = claimBestBooth()
                    if claimed then
                        print("[AUTO SELL] Successfully claimed Booth ID:", tostring(boothId))
                        getgenv().PlazaSellFreshClaimTime = os.time()
                        getgenv().PlazaSellGlobalCooldown = nil
                        getgenv().PlazaSellGlobalCooldownDur = nil
                        getgenv().PlazaSellItemCooldowns = {}
                        updateBoothCache({}, 0, {}, {}, false)
                        task.wait(3.0)
                    else
                        local cd = (reason == "cooldown") and 45 or 30
                        print(string.format("[AUTO SELL] Could not claim a booth (%s). Retrying in %ds...", tostring(reason), cd))
                        getgenv().PlazaSellGlobalCooldown = os.time()
                        getgenv().PlazaSellGlobalCooldownDur = cd
                        return
                    end
                end

                -- [4] Đọc Save & tính giới hạn slot thực tế
                local Save = getModule("Client", "Save")
                local Types = getModule("Items", "Types")
                local RAPCmds = getModule("Client", "RAPCmds")
                if not (Save and Types) then return end

                local data = Save.Get()
                if not data or not data.Inventory then return end

                local maxSlots = getMaxBoothSlots(data, config)
                local listedUIDs, listedCount, listedSlotsByName, listedAmtByName = getListedUIDs(false)

                if listedCount >= maxSlots then
                    local lastFullLog = getgenv().PlazaSellLastFullLog or 0
                    if os.time() - lastFullLog >= 60 then
                        print(string.format("[AUTO SELL] Booth full (%d/%d). Monitoring for sold slots...", listedCount, maxSlots))
                        getgenv().PlazaSellLastFullLog = os.time()
                    end
                    return
                end

                -- Tính quota & limit còn lại theo tên item (trừ đi phần đã treo trên quầy)
                local tickQuotas = {}
                for name, qty in pairs(config.CustomQuantities or {}) do
                    if type(qty) == "number" or tonumber(qty) then
                        local qNum = math.max(0, math.floor(tonumber(qty)))
                        local alreadyAmt = listedAmtByName[name] or 0
                        tickQuotas[name] = math.max(0, qNum - alreadyAmt)
                    else
                        tickQuotas[name] = "All"
                    end
                end

                local tickLimits = {}
                for name, lim in pairs(config.CustomListingsLimit or {}) do
                    if type(lim) == "number" or tonumber(lim) then
                        local lNum = math.max(0, math.floor(tonumber(lim)))
                        local alreadySlots = listedSlotsByName[name] or 0
                        tickLimits[name] = math.max(0, lNum - alreadySlots)
                    else
                        tickLimits[name] = "All"
                    end
                end

                local equippedCounts = getEquippedPetCounts(data)
                local minPrice = math.max(1, tonumber(config.MinPrice) or 1)
                local defaultRapPct = math.round(((tonumber(config.RapMultiplier) or 0.95) - 1) * 100)

                local qualifiedQueue = {}
                local scanStats = { total = 0, locked = 0, equipped = 0, noPrice = 0, belowMin = 0, cooldown = 0, alreadyListed = 0, limitReached = 0 }

                for catName, catData in pairs(data.Inventory) do
                    -- Tuyệt đối bỏ qua Currency
                    if not IGNORED_CATEGORIES[catName] and type(catData) == "table" then
                        for uid, itemData in pairs(catData) do
                            if not isSessionActive() or not getgenv().PlazaSellConfig.Enabled then return end

                            local uidStr = tostring(uid)
                            local success, itemObj = pcall(Types.From, catName, itemData)
                            if success and itemObj then
                                local isLocked = false
                                local isTradable = true
                                pcall(function()
                                    if type(itemObj.IsLocked) == "function" then
                                        isLocked = itemObj:IsLocked() == true
                                    end
                                end)
                                pcall(function()
                                    if type(itemObj.IsTradable) == "function" then
                                        isTradable = itemObj:IsTradable() ~= false
                                    end
                                end)

                                if isLocked or not isTradable then
                                    scanStats.locked = scanStats.locked + 1
                                else
                                    local rawAmt = 1
                                    pcall(function() rawAmt = itemObj:GetAmount() or 1 end)
                                    local eqCount = (catName == "Pet") and (equippedCounts[uidStr] or 0) or 0
                                    local totalAmtInInv = math.max(0, rawAmt - eqCount)

                                    if totalAmtInInv <= 0 then
                                        scanStats.equipped = scanStats.equipped + 1
                                    else
                                        local okName, itemName = pcall(function() return itemObj:GetName() end)
                                        if not okName or type(itemName) ~= "string" or itemName == "" then
                                            scanStats.noPrice = scanStats.noPrice + 1
                                        else
                                        local priceSource = "Custom"
                                        scanStats.total = scanStats.total + 1

                                        -- STRICT exact itemName match (không fallback noShiny / Directory().name -> không bleed Golden/Rainbow/Shiny)
                                        local sellPrice = config.CustomPrices and config.CustomPrices[itemName]
                                        local limitVal = (tickLimits[itemName] ~= nil) and tickLimits[itemName] or "All"
                                        local targetQty = (tickQuotas[itemName] ~= nil) and tickQuotas[itemName] or "All"

                                        local isStackableItem = not (catName == "Pet" or catName == "Hoverboard" or catName == "Booth")
                                        local belowMinPrice = false

                                        if sellPrice and sellPrice > 0 then
                                            if sellPrice < minPrice then
                                                belowMinPrice = true
                                                sellPrice = nil
                                            end
                                        else
                                            local itemCategory = catName
                                            if catName == "Pet" then
                                                if itemObj.IsHuge and itemObj:IsHuge() then
                                                    itemCategory = "Huge"
                                                elseif itemObj.IsTitanic and itemObj:IsTitanic() then
                                                    itemCategory = "Titanic"
                                                elseif (itemObj.IsGargantuan and itemObj:IsGargantuan())
                                                    or (itemObj.Gargantuan and itemObj:Gargantuan())
                                                    or (itemName and tostring(itemName):find("Gargantuan")) then
                                                    itemCategory = "Gargantuan"
                                                end
                                            end
                                            local rule = config.CategoryRules and config.CategoryRules[itemCategory]
                                            if isCategoryRuleActive(rule) then
                                                if rule.Mode == "Fixed" then
                                                    local fixedP = tonumber(rule.Price) or 0
                                                    if fixedP >= minPrice then
                                                        sellPrice = fixedP
                                                        priceSource = "Category (Fixed)"
                                                    elseif fixedP > 0 then
                                                        belowMinPrice = true
                                                    end
                                                elseif rule.Mode == "RAP" and RAPCmds and type(RAPCmds.Get) == "function" then
                                                    local rapOk, rapResult = pcall(RAPCmds.Get, itemObj)
                                                    if rapOk and type(rapResult) == "number" and rapResult > 0 then
                                                        if rapResult < minPrice then
                                                            belowMinPrice = true
                                                        else
                                                            local pct = tonumber(rule.Percent)
                                                            if pct == nil then pct = defaultRapPct end
                                                            sellPrice = math.max(minPrice, math.floor(rapResult * (1 + pct / 100)))
                                                            priceSource = string.format("RAP (%+d%%)", pct)
                                                        end
                                                    end
                                                end
                                            end
                                        end

                                        if belowMinPrice then
                                            scanStats.belowMin = scanStats.belowMin + 1
                                        elseif sellPrice and sellPrice > 0 then
                                            local alreadyListedAmt = listedUIDs[uidStr] or 0
                                            local itemCooldowns = getgenv().PlazaSellItemCooldowns
                                            local isCoolingDown = itemCooldowns[uidStr] and (os.time() - itemCooldowns[uidStr]) < 60
                                            local isQtyExhausted = (targetQty ~= "All") and ((tonumber(targetQty) or 0) <= 0)
                                            local isLimitReached = (limitVal ~= "All") and ((tonumber(limitVal) or 0) <= 0)
                                            local isAlreadyListed = (not isStackableItem and alreadyListedAmt > 0) or (isStackableItem and alreadyListedAmt >= totalAmtInInv)

                                            if not isCoolingDown and not isQtyExhausted and not isLimitReached and not isAlreadyListed then
                                                local remInv = totalAmtInInv - alreadyListedAmt
                                                local allocAmt = remInv
                                                if targetQty ~= "All" then
                                                    allocAmt = math.min(remInv, math.floor(tonumber(targetQty) or 0))
                                                end
                                                if allocAmt > 0 then
                                                    local maxSlotsForItem
                                                    if not isStackableItem then
                                                        maxSlotsForItem = 1
                                                    elseif targetQty == "All" then
                                                        maxSlotsForItem = math.max(1, maxSlots - listedCount)
                                                    else
                                                        maxSlotsForItem = math.max(1, math.ceil(allocAmt / 50000))
                                                    end
                                                    if limitVal ~= "All" then
                                                        maxSlotsForItem = math.min(maxSlotsForItem, math.floor(tonumber(limitVal) or 0))
                                                    end

                                                    if maxSlotsForItem > 0 then
                                                        table.insert(qualifiedQueue, {
                                                            cat = catName,
                                                            name = itemName,
                                                            price = sellPrice,
                                                            priceSource = priceSource,
                                                            amt = remInv,
                                                            uid = uidStr,
                                                            limitVal = limitVal,
                                                            targetQty = (targetQty == "All") and "All" or allocAmt,
                                                            maxSlots = maxSlotsForItem,
                                                            isStackable = isStackableItem
                                                        })
                                                        if type(tickQuotas[itemName]) == "number" then
                                                            tickQuotas[itemName] = math.max(0, tickQuotas[itemName] - allocAmt)
                                                        end
                                                        if type(tickLimits[itemName]) == "number" then
                                                            local estSlots = isStackableItem and math.min(maxSlotsForItem, math.ceil(allocAmt / 50000)) or 1
                                                            tickLimits[itemName] = math.max(0, tickLimits[itemName] - estSlots)
                                                        end
                                                    else
                                                        scanStats.limitReached = scanStats.limitReached + 1
                                                    end
                                                else
                                                    scanStats.limitReached = scanStats.limitReached + 1
                                                end
                                            elseif isCoolingDown then
                                                scanStats.cooldown = scanStats.cooldown + 1
                                            elseif isQtyExhausted or isLimitReached then
                                                scanStats.limitReached = scanStats.limitReached + 1
                                            elseif isAlreadyListed then
                                                scanStats.alreadyListed = scanStats.alreadyListed + 1
                                            end
                                        else
                                            scanStats.noPrice = scanStats.noPrice + 1
                                        end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

                if #qualifiedQueue > 0 then
                    print("\n======================================== [AUTO SELL SUMMARY] ========================================")
                    print(string.format("Booth Slots Used: %d/%d | Qualified Items to List: %d | MinPrice: %s", listedCount, maxSlots, #qualifiedQueue, formatNumber(minPrice)))
                    print("--------------------------------------------------------------------------------------------------------------------------------------")
                    print(string.format("%-4s | %-12s | %-30s | %-10s | %-14s | %-10s | %-9s | %-15s",
                        "No.", "Category", "Item Name", "Price", "In Stock", "Qty/Slot", "MaxSlots", "Price Source"))
                    print("--------------------------------------------------------------------------------------------------------------------------------------")
                    for idx, item in ipairs(qualifiedQueue) do
                        local qtyPerSlot = item.amt
                        if item.targetQty ~= "All" then
                            qtyPerSlot = math.min(item.amt, tonumber(item.targetQty) or item.amt)
                        end
                        qtyPerSlot = math.min(qtyPerSlot, 50000)
                        local maxSlotsStr = item.isStackable and tostring(item.maxSlots or 1) or "1 (pet)"
                        local targetQtyStr = item.targetQty == "All" and "All" or tostring(item.targetQty)
                        print(string.format("%-4d | %-12s | %-30s | %-10s | %-14s | %-10s | %-9s | %-15s",
                            idx, tostring(item.cat):sub(1, 12), tostring(item.name):sub(1, 30),
                            formatNumber(item.price),
                            string.format("%s (quota:%s)", formatNumber(item.amt), targetQtyStr),
                            formatNumber(qtyPerSlot), maxSlotsStr, tostring(item.priceSource)))
                    end
                    print("======================================================================================================================================\n")
                else
                    print(string.format(
                        "[AUTO SELL] Tick scan: 0 qualify | Scanned=%d | NoPrice=%d | BelowMin=%d | Locked/Untradable=%d | Equipped=%d | Cooldown=%d | AlreadyListed=%d | LimitReached=%d | Booth=%d/%d",
                        scanStats.total, scanStats.noPrice, scanStats.belowMin, scanStats.locked, scanStats.equipped,
                        scanStats.cooldown, scanStats.alreadyListed, scanStats.limitReached,
                        listedCount, maxSlots
                    ))
                    return
                end

                -- Enforce gap tối thiểu 4s nếu vừa gọi Booths_GetInitialState trước khi list
                local lastStateCall = getgenv().PlazaSellLastStateCall
                if lastStateCall then
                    local gap = os.time() - lastStateCall
                    if gap < 4 then
                        print(string.format("[AUTO SELL] Waiting %ds after GetInitialState before listing...", 4 - gap))
                        task.wait(4 - gap)
                    end
                    getgenv().PlazaSellLastStateCall = nil
                end

                -- Thực hiện đăng bán lần lượt các item trong Queue
                local globalCooldownTriggered = false
                local listedCountBeforeTick = listedCount
                for _, item in ipairs(qualifiedQueue) do
                    if not isSessionActive() or not getgenv().PlazaSellConfig.Enabled then break end
                    if listedCount >= maxSlots then
                        print(string.format("[AUTO SELL] Booth slots filled up (%d/%d). Stopping execution.", listedCount, maxSlots))
                        break
                    end

                    local remainingInventory = item.amt
                    local uid = item.uid
                    local itemName = item.name
                    local sellPrice = item.price
                    local limitVal = item.limitVal
                    local targetQty = item.targetQty

                    local slotsUsedForItem = 0
                    while remainingInventory > 0 and isSessionActive() and getgenv().PlazaSellConfig.Enabled do
                        if listedCount >= maxSlots then break end
                        if targetQty ~= "All" and (tonumber(targetQty) or 0) <= 0 then break end
                        if limitVal ~= "All" and (tonumber(limitVal) or 0) <= 0 then break end
                        if item.isStackable and slotsUsedForItem >= (item.maxSlots or 1) then break end

                        local sellAmt = remainingInventory
                        if targetQty ~= "All" then
                            sellAmt = math.min(remainingInventory, math.floor(tonumber(targetQty) or 0))
                        end
                        sellAmt = math.min(sellAmt, 50000)
                        if sellAmt <= 0 then break end

                        local prevBroadcast = State.Booth.LastBroadcast
                        local invokeOk, listSuccess, errMsg = pcall(function()
                            return Network.Invoke("Booths_CreateListing", uid, sellPrice, sellAmt)
                        end)
                        if invokeOk and listSuccess then
                            print(string.format("[AUTO SELL SUCCESS] Listed: %s x%d for %s Gems (%s)", itemName, sellAmt, formatNumber(sellPrice), item.priceSource))
                            remainingInventory = remainingInventory - sellAmt
                            slotsUsedForItem = slotsUsedForItem + 1

                            -- Trừ quota & limit trong tick
                            if targetQty ~= "All" then
                                targetQty = math.max(0, math.floor(tonumber(targetQty) or 0) - sellAmt)
                            end
                            if limitVal ~= "All" then
                                limitVal = math.max(0, math.floor(tonumber(limitVal) or 0) - 1)
                            end

                            if State.Booth.LastBroadcast == prevBroadcast then
                                listedCount = listedCount + 1
                                listedUIDs[uid] = (listedUIDs[uid] or 0) + sellAmt
                                State.Booth.Listed[uid] = (State.Booth.Listed[uid] or 0) + sellAmt
                                State.Booth.Count = listedCount
                                State.Booth.SlotsByName[itemName] = (State.Booth.SlotsByName[itemName] or 0) + 1
                                State.Booth.AmtByName[itemName] = (State.Booth.AmtByName[itemName] or 0) + sellAmt
                            else
                                listedUIDs = cloneMap(State.Booth.Listed)
                                listedCount = State.Booth.Count
                            end
                            getgenv().PlazaSellSlotCache = listedCount

                            task.wait(2.5)
                        else
                            local rawErr = not invokeOk and listSuccess or errMsg
                            warn(string.format("[AUTO SELL ERROR] Listing failed for %s: %s", itemName, tostring(rawErr)))
                            local errStr = tostring(rawErr or ""):lower()

                            if errStr:find("voucher") then
                                warn("[AUTO SELL] Booth slot voucher required or slot cap hit. Stopping cycle.")
                                listedCount = maxSlots
                                break
                            elseif errStr:find("slot") or errStr:find("full") or errStr:find("limit") or errStr:find("no empty") or errStr:find("max") then
                                listedCount = maxSlots
                                break
                            elseif errStr:find("fast") or errStr:find("too") then
                                print(string.format("[AUTO SELL] Rate limit hit after %d listings. Pausing 8s...", listedCount - listedCountBeforeTick))
                                task.wait(8.0)
                                break
                            elseif errStr:find("cooldown") or errStr:find("wait") then
                                if listedCount == listedCountBeforeTick then
                                    local prevDur = getgenv().PlazaSellGlobalCooldownDur or 60
                                    local nextDur = math.min(prevDur * 2, 300)
                                    getgenv().PlazaSellGlobalCooldown = os.time()
                                    getgenv().PlazaSellGlobalCooldownDur = nextDur
                                    print(string.format("[AUTO SELL] Server cooldown! Waiting %ds (backoff)...", nextDur))
                                    globalCooldownTriggered = true
                                else
                                    getgenv().PlazaSellItemCooldowns[uid] = os.time()
                                    print(string.format("[AUTO SELL] Per-item cooldown for %s.", itemName))
                                    task.wait(3.0)
                                end
                                break
                            elseif errStr:find("tradable") or errStr:find("locked") or errStr:find("equipped") or errStr:find("enough") then
                                getgenv().PlazaSellItemCooldowns[uid] = os.time()
                                break
                            else
                                getgenv().PlazaSellItemCooldowns[uid] = os.time()
                                break
                            end
                        end
                    end
                    if globalCooldownTriggered then break end
                end
            end)
            if not tickOk then
                warn("[AUTO SELL ERROR] Tick aborted with error:", tostring(tickErr))
            end
        end
    end
end

task.spawn(runAutoSellProcess)

