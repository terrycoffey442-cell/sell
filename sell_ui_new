        -- Nhóm vật phẩm giống nhau theo (catId, name, icon), cộng dồn số lượng, lazy/chunked không giật Mobile
        local function renderInventoryGrid(catId)
            State.ActiveCategory = catId
            State.GridInitialized = true
            State.GridRenderToken = State.GridRenderToken + 1
            local myToken = State.GridRenderToken

            for _, item in ipairs(UI.CatButtons) do
                if item.id == catId then
                    item.btn.BackgroundColor3 = Color3.fromRGB(0, 170, 127)
                    item.btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                else
                    item.btn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
                    item.btn.TextColor3 = Color3.fromRGB(150, 150, 150)
                end
            end

            showGridMessage("Đang tải vật phẩm...")

            local Save = getModule("Client", "Save")
            local Types = getModule("Items", "Types")
            local RAPCmds = getModule("Client", "RAPCmds")
            if not (Save and Types) then
                showGridMessage("Hòm đồ mục này đang trống.")
                return
            end

            local rawCat = catId
            if catId == "Huge" or catId == "Titanic" or catId == "Gargantuan" then
                rawCat = "Pet"
            end

            local okInv, invData = pcall(Save.Get)
            if not okInv or not invData or not invData.Inventory or not invData.Inventory[rawCat] then
                State.CachedGridCategory = catId
                State.CachedGridItems = {}
                showGridMessage("Hòm đồ mục này đang trống.")
                return
            end

            local grouped = {}
            local groupedList = {}
            local scannedCount = 0

            for uid, itemData in pairs(invData.Inventory[rawCat]) do
                if myToken ~= State.GridRenderToken or not isSessionActive() then return end
                scannedCount = scannedCount + 1
                local success, itemObj = pcall(Types.From, rawCat, itemData)
                if success and itemObj then
                    local keep = false
                    local itemName = ""
                    pcall(function() itemName = itemObj:GetName() or "" end)

                    if rawCat == "Pet" then
                        local isHuge = itemObj.IsHuge and itemObj:IsHuge()
                        local isTitanic = itemObj.IsTitanic and itemObj:IsTitanic()
                        local isGargantuan = (itemObj.IsGargantuan and itemObj:IsGargantuan())
                            or (itemObj.Gargantuan and itemObj:Gargantuan())
                            or (itemName:find("Gargantuan") ~= nil)

                        if catId == "Pet" then
                            keep = (not isHuge and not isTitanic and not isGargantuan)
                        elseif catId == "Huge" then
                            keep = (isHuge == true)
                        elseif catId == "Titanic" then
                            keep = (isTitanic == true)
                        elseif catId == "Gargantuan" then
                            keep = (isGargantuan == true)
                        end
                    else
                        keep = true
                    end

                    if keep and itemName ~= "" then
                        local rawIc = nil
                        pcall(function() rawIc = itemObj:GetIcon() end)
                        local iconUrl = toRobloxAssetUrl(rawIc)
                        local amt = 1
                        pcall(function() amt = itemObj:GetAmount() or 1 end)

                        local gKey = catId .. "\0" .. itemName .. "\0" .. iconUrl
                        local existingEntry = grouped[gKey]
                        if existingEntry then
                            existingEntry.amount = existingEntry.amount + amt
                        else
                            local rapVal = 0
                            if RAPCmds and type(RAPCmds.Get) == "function" then
                                local getRapOk, rapRes = pcall(RAPCmds.Get, itemObj)
                                if getRapOk and type(rapRes) == "number" then
                                    rapVal = rapRes
                                end
                            end
                            local entry = {
                                uid = uid,
                                name = itemName,
                                amount = amt,
                                icon = iconUrl,
                                rap = rapVal,
                                data = itemData
                            }
                            grouped[gKey] = entry
                            table.insert(groupedList, entry)
                        end
                    end
                end
                if scannedCount % 150 == 0 then
                    task.wait()
                end
            end

            if myToken ~= State.GridRenderToken or not isSessionActive() then return end

            table.sort(groupedList, function(a, b)
                if a.rap == b.rap then
                    return a.name < b.name
                end
                return a.rap > b.rap
            end)

            State.CachedGridCategory = catId
            State.CachedGridItems = groupedList
            filterAndDrawGrid(myToken)
        end
