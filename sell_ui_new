local CONFIG_FILE = "PlazaSellConfig.json"

local function saveConfig()
    local success, err = pcall(function()
        if writefile then
            local data = HttpService:JSONEncode(getgenv().PlazaSellConfig)
            writefile(CONFIG_FILE, data)
            print("[CONFIG] Configuration successfully saved to " .. CONFIG_FILE)
        end
    end)
    if not success then
        warn("[CONFIG] Error saving configuration:", err)
    end
end

local function normalizeCategoryRule(rule, minPrice, defaultRapPct)
    local floorPrice = math.max(1000, tonumber(minPrice) or 1000)
    local fallbackPct = tonumber(defaultRapPct) or -5
    if type(rule) ~= "table" then
        return {
            Enabled = false,
            Mode = "Fixed",
            Price = floorPrice,
            Percent = fallbackPct,
        }
    end
    -- Config cũ chưa có cờ Enabled (hoặc Mode == "Disabled") luôn ép Enabled = false để tránh tự sell ngoài ý muốn
    if type(rule.Enabled) ~= "boolean" then
        rule.Enabled = false
    end
    if rule.Mode ~= "Fixed" and rule.Mode ~= "RAP" then
        rule.Mode = "Fixed"
        rule.Enabled = false
    end
    rule.Price = math.max(1, tonumber(rule.Price) or floorPrice)
    rule.Percent = tonumber(rule.Percent)
    if rule.Percent == nil then
        rule.Percent = fallbackPct
    end
    return rule
end

local function isCategoryRuleActive(rule)
    return type(rule) == "table" and rule.Enabled == true and (rule.Mode == "Fixed" or rule.Mode == "RAP")
end

local function loadConfig()
    local success, data = pcall(function()
        if isfile and readfile and isfile(CONFIG_FILE) then
            return readfile(CONFIG_FILE)
        end
    end)
    if success and type(data) == "string" and #data > 0 then
        local decodeOk, decoded = pcall(function()
            return HttpService:JSONDecode(data)
        end)
        if decodeOk and type(decoded) == "table" then
            for k, v in pairs(decoded) do
                getgenv().PlazaSellConfig[k] = v
            end
            print("[CONFIG] Configuration loaded successfully from " .. CONFIG_FILE)
        elseif not decodeOk then
            warn("[CONFIG] Corrupt configuration JSON, keeping defaults:", tostring(decoded))
        end
    end
    local cfg = getgenv().PlazaSellConfig
    cfg.MinPrice = tonumber(cfg.MinPrice) or 1000
    cfg.MaxSlots = math.clamp(math.floor(tonumber(cfg.MaxSlots) or 50), 1, 100)
    cfg.RapMultiplier = tonumber(cfg.RapMultiplier) or 0.95
    cfg.MinPlayers = tonumber(cfg.MinPlayers) or 5
    cfg.AutoRejoinRAM = tonumber(cfg.AutoRejoinRAM) or 4000
    cfg.AutoRejoinTime = tonumber(cfg.AutoRejoinTime) or 10800
    cfg.CustomPrices = type(cfg.CustomPrices) == "table" and cfg.CustomPrices or {}
    cfg.CustomQuantities = type(cfg.CustomQuantities) == "table" and cfg.CustomQuantities or {}
    cfg.CustomListingsLimit = type(cfg.CustomListingsLimit) == "table" and cfg.CustomListingsLimit or {}
    cfg.CategoryRules = type(cfg.CategoryRules) == "table" and cfg.CategoryRules or {}
    local defaultRapPct = math.round((cfg.RapMultiplier - 1) * 100)
    for catKey, catRule in pairs(cfg.CategoryRules) do
        cfg.CategoryRules[catKey] = normalizeCategoryRule(catRule, cfg.MinPrice, defaultRapPct)
    end
    cfg.Categories = discoverCategories()
end

loadConfig()

-- 3. Các hàm bổ trợ xử lý số & ảnh
local function parseNumber(str)
    if str == nil then return nil end
    if type(str) == "number" then return math.floor(str) end
    str = tostring(str)
    if str == "" then return nil end
    str = str:lower():gsub("%s+", ""):gsub(",", "")
    local multiplier = 1
    if str:find("k$") then
        multiplier = 1e3
        str = str:sub(1, -2)
    elseif str:find("m$") then
        multiplier = 1e6
        str = str:sub(1, -2)
    elseif str:find("b$") then
        multiplier = 1e9
        str = str:sub(1, -2)
    elseif str:find("t$") then
        multiplier = 1e12
        str = str:sub(1, -2)
    end
    local num = tonumber(str)
    return num and math.floor(num * multiplier) or nil
end

local function formatNumber(num)
    if not num then return "" end
    if num >= 1e12 then
        return string.format("%.2ft", num / 1e12):gsub("%.00t", "t"):gsub("%.([0-9])0t", ".%1t")
    elseif num >= 1e9 then
        return string.format("%.2fb", num / 1e9):gsub("%.00b", "b"):gsub("%.([0-9])0b", ".%1b")
    elseif num >= 1e6 then
        return string.format("%.2fm", num / 1e6):gsub("%.00m", "m"):gsub("%.([0-9])0m", ".%1m")
    elseif num >= 1e3 then
        return string.format("%.2fk", num / 1e3):gsub("%.00k", "k"):gsub("%.([0-9])0k", ".%1k")
    end
    return tostring(num)
end

