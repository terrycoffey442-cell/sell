            resizing = false
        end
    end)

    bindConn(UserInputService.InputChanged, function(input)
        if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local scale = math.max(0.1, uiScale.Scale or 1)
            local delta = (input.Position - resizeStartPos) / scale
            local newWidth = math.clamp(resizeStartSize.X + delta.X, 580, 1200)
            local newHeight = math.clamp(resizeStartSize.Y + delta.Y, 420, 900)
            MainFrame.Size = UDim2.fromOffset(newWidth, newHeight)
