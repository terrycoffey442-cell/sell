local function isBoothsLoaded()
    if not (Signal and type(Signal.Invoke) == "function") then
        return true
    end
    local done, ok, res = false, false, nil
    task.spawn(function()
        ok, res = pcall(Signal.Invoke, "Booths_IsLoaded")
        done = true
    end)
