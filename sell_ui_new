local function bindConn(signalObj, fn)
    if not signalObj or type(fn) ~= "function" then return nil end
    local ok, conn = pcall(function()
        return signalObj:Connect(fn)
    end)
    if ok and conn then
        table.insert(State.Conns, conn)
        return conn
    end
    return nil
end

local function isSessionActive()
    return State.Active and getgenv().PlazaSellSession == SessionId
end

local function Teardown()
    State.Active = false
    State.AntiAFKLoopActive = false
    getgenv()._PlazaAntiAFKLoop = nil
    if getgenv().PlazaSellSession == SessionId then
        getgenv().PlazaSellSession = nil
    end
    if getgenv().AutoSellSession == SessionId then
        getgenv().AutoSellSession = nil
    end
    if getgenv().AntiAFKConnection then
        pcall(function() getgenv().AntiAFKConnection:Disconnect() end)
        getgenv().AntiAFKConnection = nil
    end
    for _, conn in ipairs(State.AntiAFKConns) do
        pcall(function() conn:Disconnect() end)
    end
    State.AntiAFKConns = {}
    for _, conn in ipairs(State.Conns) do
        pcall(function() conn:Disconnect() end)
    end
    State.Conns = {}
    if UI.ScreenGui then
        pcall(function() UI.ScreenGui:Destroy() end)
        UI.ScreenGui = nil
    end
    if UI.ToggleGui then
        pcall(function() UI.ToggleGui:Destroy() end)
        UI.ToggleGui = nil
    end
end
