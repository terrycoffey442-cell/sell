local function applyTranslations(parent)
    if not parent or not getgenv().PlazaSellConfig then return end
    local isEng = getgenv().PlazaSellConfig.Language == "English"
    local map = isEng and StringMap or ReverseStringMap

    local function traverse(obj)
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            local i18nVi = obj:GetAttribute("I18nVi")
            local i18nEn = obj:GetAttribute("I18nEn")
            if obj:IsA("TextBox") then
                if i18nVi and i18nEn and (obj.Text == i18nVi or obj.Text == i18nEn) then
                    obj.Text = isEng and i18nEn or i18nVi
                end
                if obj.PlaceholderText and map[obj.PlaceholderText] then
                    obj.PlaceholderText = map[obj.PlaceholderText]
                end
            elseif not obj:GetAttribute("NoTranslate") then
                if i18nVi and i18nEn then
                    obj.Text = isEng and i18nEn or i18nVi
                elseif map[obj.Text] then
                    obj.Text = map[obj.Text]
                end
            end
        end
        for _, child in ipairs(obj:GetChildren()) do
            traverse(child)
        end
    end
    traverse(parent)
end

