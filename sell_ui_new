-- 11. SAFE ANTI-AFK (Tương thích PC & Mobile/Delta - không hookfunction/VIM/getconnections trên Mobile)
-- --------------------------------------------------------------------------
local function isMobileEnv()
    local isTouchOnly = false
    pcall(function()
        isTouchOnly = (UserInputService.TouchEnabled == true) and (UserInputService.KeyboardEnabled ~= true)
    end)
    local execName = ""
    pcall(function()
        if type(identifyexecutor) == "function" then
            execName = tostring(identifyexecutor() or "")
        elseif type(getexecutorname) == "function" then
            execName = tostring(getexecutorname() or "")
        end
    end)
    local lowerExec = execName:lower()
    for _, marker in ipairs({ "delta", "arceus", "codex", "fluxus", "hydrogen", "vegax", "cryptic" }) do
        if lowerExec:find(marker, 1, true) then
            return true
        end
    end
    return isTouchOnly
end

local function disableIdleScriptInstance(inst)
    if not inst or not (inst:IsA("LocalScript") or inst:IsA("Script")) then
        return false
    end
    pcall(function() inst.Disabled = true end)
    pcall(function() inst.Enabled = false end)
    if inst:GetAttribute("PlazaAFKBound") ~= true then
        inst:SetAttribute("PlazaAFKBound", true)
        local conn = inst:GetPropertyChangedSignal("Enabled"):Connect(function()
            if isSessionActive() and getgenv().PlazaSellConfig.AntiAFK and inst.Enabled then
                pcall(function()
                    inst.Disabled = true
                    inst.Enabled = false
                end)
            end
        end)
        table.insert(State.AntiAFKConns, conn)
    end
    State.IdleTrackingDisabled = true
    return true
end

local function disableP99IdleScripts()
    local ps = LocalPlayer:FindFirstChild("PlayerScripts")
    local scriptsFolder = ps and ps:FindFirstChild("Scripts")
    local coreFolder = scriptsFolder and scriptsFolder:FindFirstChild("Core")
    if coreFolder then
        local idleScript = coreFolder:FindFirstChild("Idle Tracking")
        if idleScript then disableIdleScriptInstance(idleScript) end
        local serverClosing = coreFolder:FindFirstChild("Server Closing")
        if serverClosing then disableIdleScriptInstance(serverClosing) end

        if not State.IdleTrackingWatched then
            State.IdleTrackingWatched = true
            local c = coreFolder.ChildAdded:Connect(function(child)
                if isSessionActive() and getgenv().PlazaSellConfig.AntiAFK and child and (child.Name == "Idle Tracking" or child.Name == "Server Closing") then
                    disableIdleScriptInstance(child)
                end
            end)
            table.insert(State.AntiAFKConns, c)
        end
    elseif not State.IdleTrackingWatched then
        State.IdleTrackingWatched = true
        local function attachCore(core)
            if not core then return end
            local idle = core:FindFirstChild("Idle Tracking")
            if idle then disableIdleScriptInstance(idle) end
            local sc = core:FindFirstChild("Server Closing")
            if sc then disableIdleScriptInstance(sc) end
            table.insert(State.AntiAFKConns, core.ChildAdded:Connect(function(child)
                if isSessionActive() and getgenv().PlazaSellConfig.AntiAFK and child and (child.Name == "Idle Tracking" or child.Name == "Server Closing") then
                    disableIdleScriptInstance(child)
                end
            end))
        end
        local function attachScripts(scripts)
            if not scripts then return end
            local c = scripts:FindFirstChild("Core")
            if c then
                attachCore(c)
            else
                table.insert(State.AntiAFKConns, scripts.ChildAdded:Connect(function(child)
                    if isSessionActive() and child and child.Name == "Core" then attachCore(child) end
                end))
            end
        end
        if ps then
            local s = ps:FindFirstChild("Scripts")
            if s then
                attachScripts(s)
            else
                table.insert(State.AntiAFKConns, ps.ChildAdded:Connect(function(child)
                    if isSessionActive() and child and child.Name == "Scripts" then attachScripts(child) end
                end))
            end
        end
    end
end

local function pulseAntiAFK(isMobile)
    pcall(function()
        if VirtualUser then
            VirtualUser:CaptureController()
            if workspace.CurrentCamera then
                VirtualUser:ClickButton2(Vector2.zero, workspace.CurrentCamera.CFrame)
            else
                VirtualUser:ClickButton2(Vector2.zero)
            end
        end
    end)
    pcall(function()
        if Network and type(Network.Fire) == "function" then
            Network.Fire("Idle Tracking: Focus Changed", true)
            Network.Fire("Idle Tracking: Stop Timer", isMobile and 7 or 0)
        end
    end)
end

local function stopAntiAFK()
    State.AntiAFKLoopActive = false
    getgenv()._PlazaAntiAFKLoop = nil
    for _, conn in ipairs(State.AntiAFKConns) do
        pcall(function() conn:Disconnect() end)
    end
    State.AntiAFKConns = {}
    State.IdleTrackingWatched = false
    if getgenv().AntiAFKConnection then
        pcall(function() getgenv().AntiAFKConnection:Disconnect() end)
        getgenv().AntiAFKConnection = nil
    end
end

local function initAntiAFK()
    stopAntiAFK()
    local cfg = getgenv().PlazaSellConfig
    if not isSessionActive() or not cfg or not cfg.AntiAFK then return end

    local isMobile = isMobileEnv()

    -- Layer 1: Disable PS99 Idle Tracking & Server Closing + ChildAdded watcher
    pcall(disableP99IdleScripts)

    -- Layer 2: Idled event của Roblox
    local idledConn = LocalPlayer.Idled:Connect(function()
        if isSessionActive() and getgenv().PlazaSellConfig.AntiAFK then
            pulseAntiAFK(isMobile)
        end
    end)
    table.insert(State.AntiAFKConns, idledConn)
    getgenv().AntiAFKConnection = idledConn

    -- Layer 3: Pulse ban đầu + vòng lặp 45 giây (Safe Mode: không hookfunction/VIM/getconnections trên Mobile)
    pulseAntiAFK(isMobile)
    State.AntiAFKLoopActive = true
    getgenv()._PlazaAntiAFKLoop = SessionId

    task.spawn(function()
        while isSessionActive() and State.AntiAFKLoopActive and getgenv()._PlazaAntiAFKLoop == SessionId do
            task.wait(45)
            if not isSessionActive() or not State.AntiAFKLoopActive or not getgenv().PlazaSellConfig.AntiAFK then
                break
            end
            if not State.IdleTrackingDisabled then
                pcall(disableP99IdleScripts)
            end
            pulseAntiAFK(isMobile)
        end
    end)

    print(string.format("[SYSTEM] Safe Anti-AFK initialized (mobile=%s, interval=45s).", tostring(isMobile)))
end

UI.OnToggleAntiAFK = function(state)
    if state then
        initAntiAFK()
    else
        stopAntiAFK()
        print("[SYSTEM] Anti-AFK deactivated.")
    end
end

task.defer(initAntiAFK)

