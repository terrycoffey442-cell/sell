-- Nạp an toàn các module phụ trợ từ Library
local function getModule(group, name)
    local key = group .. "." .. name
    if Modules[key] ~= nil then
        return Modules[key] or nil
    end
    local mod = nil
    pcall(function()
        local folder = (group == "Root") and Library or Library:FindFirstChild(group)
        local target = folder and folder:FindFirstChild(name)
        if target and target:IsA("ModuleScript") then
            mod = require(target)
        end
    end)
    Modules[key] = mod or false
    return mod
end

local function discoverCategories()
    local seen = {}
    local merged = {}
    local function addCat(catName)
        if type(catName) ~= "string" or catName == "" or IGNORED_CATEGORIES[catName] then
            return
        end
        if not seen[catName] then
            seen[catName] = true
            table.insert(merged, catName)
        end
    end

    local cfg = getgenv().PlazaSellConfig
    if cfg and type(cfg.Categories) == "table" then
        for _, c in ipairs(cfg.Categories) do
            addCat(c)
        end
    end
    for _, c in ipairs(DEFAULT_CATEGORIES) do
        addCat(c)
    end
    local orderMod = getModule("Items", "Order")
    if orderMod and type(orderMod.OrderInv) == "table" then
        for _, c in ipairs(orderMod.OrderInv) do
            addCat(c)
        end
    end
    return merged
end

