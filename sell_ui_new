-- Đồng bộ Booth State trực tiếp từ Broadcast & InitialState (Loại bỏ getsenv)
local function parseBoothListings(listingsTable)
    local listed = {}
    local count = 0
    local slotsByName = {}
    local amtByName = {}
    if type(listingsTable) ~= "table" then
        return listed, 0, slotsByName, amtByName
    end

    local Types = getModule("Items", "Types")
    for listingKey, listing in pairs(listingsTable) do
        if type(listing) == "table" then
            local itemUID = nil
            local amt = 1
            local itemName = nil

            if listing.Item and type(listing.Item) == "table" then
                pcall(function()
                    if type(listing.Item.GetUID) == "function" then
                        itemUID = listing.Item:GetUID()
                    end
                end)
                itemUID = itemUID or listing.Item._uid or listing.Item.uid
                pcall(function()
                    if type(listing.Item.GetAmount) == "function" then
                        amt = listing.Item:GetAmount() or 1
                    end
                end)
                pcall(function()
                    if type(listing.Item.GetName) == "function" then
                        itemName = listing.Item:GetName()
                    end
                end)
            end

            local itemData = listing.ItemData
            if type(itemData) == "table" then
                local nested = type(itemData.data) == "table" and itemData.data or nil
                if not itemUID then
                    itemUID = itemData.uid or itemData._uid or (nested and (nested.uid or nested._uid))
                end
                if nested and (nested._am ~= nil or nested.am ~= nil) then
                    amt = tonumber(nested._am or nested.am) or 1
                elseif itemData._am ~= nil or itemData.am ~= nil then
                    amt = tonumber(itemData._am or itemData.am) or 1
                end
                if not itemName then
                    if nested and itemData.class and Types and type(Types.From) == "function" then
                        pcall(function()
                            local obj = Types.From(itemData.class, nested)
                            if obj and type(obj.GetName) == "function" then
                                itemName = obj:GetName()
                            end
                        end)
                    end
                    itemName = itemName or (nested and nested.id) or itemData.id
                end
            end

            if not itemUID then
                itemUID = listingKey
            end
            if itemUID then
                local uidKey = tostring(itemUID)
                local numAmt = math.max(1, tonumber(amt) or 1)
                listed[uidKey] = (listed[uidKey] or 0) + numAmt
                count = count + 1
                if itemName then
                    slotsByName[itemName] = (slotsByName[itemName] or 0) + 1
                    amtByName[itemName] = (amtByName[itemName] or 0) + numAmt
                end
            end
        end
    end
    return listed, count, slotsByName, amtByName
end

local function updateBoothCache(listed, count, slotsByName, amtByName, isBroadcast)
    State.Booth.Listed = listed
    State.Booth.Count = count
    State.Booth.SlotsByName = slotsByName
    State.Booth.AmtByName = amtByName
    State.Booth.Hydrated = true
    State.Booth.LastFetch = os.time()
    if isBroadcast then
        State.Booth.LastBroadcast = os.clock()
    end
    getgenv().PlazaSellListedCache = {
        listed = listed,
        count = count,
        slotsByName = slotsByName,
        amtByName = amtByName,
        ts = os.time()
    }
    getgenv().PlazaSellSlotCache = count
end

-- Lắng nghe Booths_Broadcast (single deduped listener được cleanup khi re-execute)
bindConn(Network.Fired("Booths_Broadcast"), function(player, rawPacket)
    if not isSessionActive() then return end
    local pkt = (type(rawPacket) == "table" and rawPacket) or (type(player) == "table" and player) or nil
    local isMine = (player == LocalPlayer)
    if not isMine and type(pkt) == "table" then
        local ownerObj = pkt.Player or pkt.Owner or pkt.player or pkt.owner
        if ownerObj == LocalPlayer or (typeof(ownerObj) == "Instance" and ownerObj:IsA("Player") and ownerObj.UserId == LocalPlayer.UserId) then
            isMine = true
        else
            local pid = pkt.PlayerID or pkt.PlayerId or pkt.UserId or pkt.OwnerId or pkt.PlayerUserId
            if pid and tostring(pid) == tostring(LocalPlayer.UserId) then
                isMine = true
            end
        end
    end
    if not isMine then return end

    if type(pkt) == "table" and type(pkt.Listings) == "table" then
        local listed, count, slotsByName, amtByName = parseBoothListings(pkt.Listings)
        updateBoothCache(listed, count, slotsByName, amtByName, true)
    elseif rawPacket == nil and player == LocalPlayer then
        updateBoothCache({}, 0, {}, {}, true)
    end
end)

-- Hàm lấy ảnh của vật phẩm từ rương đồ hoặc Directory toàn cục bằng tên (trả về rbxassetid:// cho UI Roblox)
local function getItemIconByName(itemName)
    if type(itemName) ~= "string" or itemName == "" then return "" end
    local Save = getModule("Client", "Save")
    local Types = getModule("Items", "Types")
    local Directory = getModule("Root", "Directory")

    -- 1. Tìm trong rương đồ hiện tại
    if Save and Types and type(Save.Get) == "function" and type(Types.From) == "function" then
        local okData, data = pcall(Save.Get)
        if okData and data and type(data.Inventory) == "table" then
            for catName, catData in pairs(data.Inventory) do
                if not IGNORED_CATEGORIES[catName] and type(catData) == "table" then
                    for _, itemData in pairs(catData) do
                        local okObj, itemObj = pcall(Types.From, catName, itemData)
                        if okObj and itemObj and type(itemObj.GetName) == "function" then
                            local okName, nm = pcall(itemObj.GetName, itemObj)
                            if okName and nm == itemName and type(itemObj.GetIcon) == "function" then
                                local okIc, ic = pcall(itemObj.GetIcon, itemObj)
                                if okIc and ic then
                                    local rbxUrl = toRobloxAssetUrl(ic)
                                    if rbxUrl ~= "" then return rbxUrl end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- 2. Tìm trong Directory toàn cục (xử lý đúng số nhiều + DisplayName string/function + variant)
    if Directory and Types and type(Types.From) == "function" then
        local workName = itemName
        local isShiny = false
        if workName:sub(1, 6) == "Shiny " then
            isShiny = true
            workName = workName:sub(7)
        end
        local ptVal = nil
        if workName:sub(1, 7) == "Golden " then
            ptVal = 1
            workName = workName:sub(8)
        elseif workName:sub(1, 8) == "Rainbow " then
            ptVal = 2
            workName = workName:sub(9)
        end

        local romanToNum = { I = 1, II = 2, III = 3, IV = 4, V = 5, VI = 6, VII = 7, VIII = 8, IX = 9, X = 10 }
        local parts = string.split(workName, " ")
        local lastPart = parts[#parts]
        local baseId = workName
        local tierVal = nil
        if romanToNum[lastPart] then
            tierVal = romanToNum[lastPart]
            table.remove(parts, #parts)
            baseId = table.concat(parts, " ")
        end

        local dirToCat = {
            Pets = "Pet",
            Eggs = "Egg",
            Enchants = "Enchant",
            Potions = "Potion",
            XPPotions = "XPPotion",
            Hoverboards = "Hoverboard",
            Charms = "Charm",
            Lootboxes = "Lootbox",
            Boxes = "Box",
            Ultimates = "Ultimate",
            Booths = "Booth",
            Fruits = "Fruit",
            Consumables = "Consumable",
            MiscItems = "Misc",
            CardItems = "Card",
            Tools = "Tool",
            ToolEnchants = "ToolEnchant",
            Pickaxes = "Pickaxe",
            PickaxeEnchants = "PickaxeEnchant",
            Seeds = "Seed",
        }

        for dirName, catGuess in pairs(dirToCat) do
            local okDir, dirData = pcall(function() return Directory[dirName] end)
            if okDir and type(dirData) == "table" then
                for key, info in pairs(dirData) do
                    local dispName = nil
                    if type(info) == "table" then
                        if type(info.DisplayName) == "function" then
                            local okD, d = pcall(info.DisplayName, tierVal or 1)
                            if okD and type(d) == "string" then dispName = d end
                        elseif type(info.DisplayName) == "string" then
                            dispName = info.DisplayName
                        elseif type(info.Name) == "string" then
                            dispName = info.Name
                        elseif type(info.name) == "string" then
                            dispName = info.name
                        end
                    end

                    local matched = (key == workName or key == baseId or key == itemName)
                        or (dispName and (dispName == workName or dispName == baseId or dispName == itemName))
                        or (type(info) == "table" and (info.id == workName or info.id == baseId or info.id == itemName))

                    if matched then
                        local okObj, itemObj = pcall(Types.From, catGuess, {
                            id = key,
                            _tier = tierVal,
                            tn = tierVal,
                            tier = tierVal,
                            pt = ptVal,
                            sh = isShiny and true or nil,
                        })
                        if okObj and itemObj and type(itemObj.GetIcon) == "function" then
                            local okIc, ic = pcall(itemObj.GetIcon, itemObj)
                            if okIc and ic then
                                local rbxUrl = toRobloxAssetUrl(ic)
                                if rbxUrl ~= "" then return rbxUrl end
                            end
                        end
                        if type(info) == "table" then
                            local rawIc = info.Icon or info.icon or info.thumbnail
                            if type(rawIc) == "function" then
                                local okRaw, resRaw = pcall(rawIc, tierVal or 1)
                                rawIc = okRaw and resRaw or nil
                            end
                            local rbxUrl = toRobloxAssetUrl(rawIc)
                            if rbxUrl ~= "" then return rbxUrl end
                        end
                    end
                end
            end
        end
    end
    return ""
end

-- Lắng nghe sự kiện "Booths: Add History" từ game để bắn Discord Webhook & cập nhật quota
bindConn(Network.Fired("Booths: Add History"), function(saleLog)
    if not isSessionActive() then return end
    local success, err = pcall(function()
        if not saleLog or not getgenv().PlazaSellConfig then return end

        local Types = getModule("Items", "Types")
        local price = 0
        local isSale = true
        local soldEntries = {}

        local decodedOk = false
        if Types and type(Types.DecodeUnpacked) == "function" then
            local okDec, received, given = pcall(function()
                return Types.DecodeUnpacked(saleLog.Received), Types.DecodeUnpacked(saleLog.Given)
            end)
            if okDec and type(received) == "table" and type(given) == "table" and (#received > 0 or #given > 0) then
                for _, item in ipairs(received) do
                    if type(item.IsA) == "function" and item:IsA("Currency") then
                        price = math.max(price, (type(item.GetAmount) == "function" and item:GetAmount()) or 0)
                    else
                        isSale = false -- Nhận được vật phẩm => Giao dịch mua, không phải bán
                    end
                end
                if isSale then
                    for _, item in ipairs(given) do
                        if type(item.IsA) == "function" and item:IsA("Currency") then
                            price = math.max(price, (type(item.GetAmount) == "function" and item:GetAmount()) or 0)
                        else
                            local nm = type(item.GetName) == "function" and item:GetName() or "Item"
                            local amt = type(item.GetAmount) == "function" and (item:GetAmount() or 1) or 1
                            local ic = type(item.GetIcon) == "function" and item:GetIcon() or nil
                            table.insert(soldEntries, { name = nm, amount = amt, iconAsset = ic })
                        end
                    end
                end
                decodedOk = true
            end
        end

        -- Raw table fallback (khi DecodeUnpacked không hỗ trợ hoặc payload dạng raw table)
        if not decodedOk then
            if type(saleLog.Received) == "table" then
                for rCat, rItems in pairs(saleLog.Received) do
                    if rCat == "Currency" and type(rItems) == "table" then
                        for _, cur in pairs(rItems) do
                            if type(cur) == "table" and (cur.id == "Diamonds" or cur.id == nil) then
                                price = math.max(price, tonumber(cur._am) or 0)
                            end
                        end
                    elseif type(rItems) == "table" and next(rItems) ~= nil then
                        isSale = false
                    end
                end
            end
            if isSale and type(saleLog.Given) == "table" then
                for catName, catItems in pairs(saleLog.Given) do
                    if catName ~= "Currency" and type(catItems) == "table" then
                        for _, rawItem in pairs(catItems) do
                            if type(rawItem) == "table" then
                                local nm, amt, ic = nil, tonumber(rawItem._am) or 1, nil
                                if Types and type(Types.From) == "function" then
                                    local okObj, obj = pcall(Types.From, catName, rawItem)
                                    if okObj and obj then
                                        pcall(function() nm = obj:GetName() end)
                                        pcall(function() amt = obj:GetAmount() or amt end)
                                        pcall(function() ic = obj:GetIcon() end)
                                    end
                                end
                                if not nm then
                                    local pfx = (rawItem.sh and "Shiny " or "")
                                        .. (rawItem.pt == 1 and "Golden " or (rawItem.pt == 2 and "Rainbow " or ""))
                                    nm = pfx .. tostring(rawItem.id or "Item")
                                end
                                table.insert(soldEntries, { name = nm, amount = amt, iconAsset = ic })
                            end
                        end
                    end
                end
            end
        end

        if not isSale or #soldEntries == 0 then return end

        local config = getgenv().PlazaSellConfig
        for _, sold in ipairs(soldEntries) do
            local itemName = sold.name
            local amount = sold.amount or 1
            print(string.format("[WEBHOOK] Sold: %s x%d for %s Gems", itemName, amount, formatNumber(price)))

            -- Cập nhật quota & số lần treo còn lại (match chính xác itemName)
            if config.CustomQuantities and config.CustomQuantities[itemName] ~= nil then
                local qty = config.CustomQuantities[itemName]
                if type(qty) == "number" or tonumber(qty) then
                    local newQty = math.max(0, tonumber(qty) - amount)
                    config.CustomQuantities[itemName] = (newQty <= 0) and 0 or newQty
                end
            end
            if config.CustomListingsLimit and config.CustomListingsLimit[itemName] ~= nil then
                local limit = config.CustomListingsLimit[itemName]
                if type(limit) == "number" or tonumber(limit) then
                    local newLimit = math.max(0, tonumber(limit) - 1)
                    config.CustomListingsLimit[itemName] = (newLimit <= 0) and 0 or newLimit
                end
            end

            recordSale(itemName, price, amount)

            local iconUrl = sold.iconAsset and getAssetThumbnailUrl(sold.iconAsset) or ""
            if iconUrl == "" then
                local localAsset = getItemIconByName(itemName)
                if localAsset ~= "" then
                    iconUrl = getAssetThumbnailUrl(localAsset)
                end
            end
            if iconUrl == "" then
                iconUrl = getAssetThumbnailUrl(14293722239)
            end
            queueSaleForWebhook(itemName, amount, price, iconUrl)
        end

        saveConfig()

        -- Invalidate listing cache để bot quét ngay slot vừa trống
        State.Booth.Hydrated = false
        getgenv().PlazaSellListedCache = nil
        if getgenv().PlazaSellSlotCache and getgenv().PlazaSellSlotCache > 0 then
            getgenv().PlazaSellSlotCache = math.max(0, getgenv().PlazaSellSlotCache - 1)
        end
    end)
    if not success then
        warn("[WEBHOOK ERROR] Error in Booths: Add History listener:", tostring(err))
    end
end)

