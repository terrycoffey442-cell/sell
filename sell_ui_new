        local function filterAndDrawGrid(renderToken)
            if renderToken == nil then
                State.GridRenderToken = State.GridRenderToken + 1
                renderToken = State.GridRenderToken
            elseif renderToken ~= State.GridRenderToken then
                return
            end
            clearGridScroll()

            local cached = State.CachedGridItems or {}
            if #cached == 0 then
