local function recordSale(itemName, price, amount)
    local stats = getgenv().PlazaSellStats
    table.insert(stats.SalesLog, {
        timestamp = os.time(),
        name = itemName,
        price = price,
        amount = amount or 1
    })

    -- Dọn dẹp log cũ hơn 24 giờ (86400 giây)
    local now = os.time()
    local activeLog = {}
    for _, sale in ipairs(stats.SalesLog) do
        if now - sale.timestamp <= 86400 then
            table.insert(activeLog, sale)
        end
    end
    stats.SalesLog = activeLog
end
getgenv().RecordSale = recordSale

local function getSalesStats()
    local now = os.time()
    local count1H, count24H, gems1H, gems24H = 0, 0, 0, 0
    for _, sale in ipairs(getgenv().PlazaSellStats.SalesLog) do
        local age = now - sale.timestamp
        if age <= 86400 then
            local amt = sale.amount or 1
            count24H = count24H + amt
            gems24H = gems24H + (sale.price or 0)
            if age <= 3600 then
                count1H = count1H + amt
                gems1H = gems1H + (sale.price or 0)
            end
        end
    end
    return count1H, count24H, gems1H, gems24H
end

